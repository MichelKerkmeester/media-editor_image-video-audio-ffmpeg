# OS-generated files
.DS_Store

# media files/: keep the three folders and their .gitkeep, ignore the media in them
media files/import/*
!media files/import/.gitkeep
media files/export/*
!media files/export/.gitkeep
media files/tests/*
!media files/tests/.gitkeep

# Spec folders are tracked; this overrides the global /specs ignore
!/specs/

# specs/personal/: your own spec folders stay on this machine. The track, .gitkeep and README.md are tracked
/specs/personal/*
!/specs/personal/.gitkeep
!/specs/personal/README.md

# Deep-loop write-containment snapshots copy files from the whole working tree, private Barter
# files included, so they never enter this public repo
specs/**/containment/

# Third-party projects kept on disk as research reference: never shipped, installed or redistributed here
/specs/system/003-media-editor-extension/context/imagician-main/
/specs/system/003-media-editor-extension/context/video-audio-mcp-main/

# ─────────────────────────────────────────────────────────────────
# DEEP RESEARCH: AUTONOMOUS DEEP RESEARCH LOOP (AUTO MODE)
# ─────────────────────────────────────────────────────────────────
# YAML PREDICATE GRAMMAR CONTRACT (S7 / M11):
# - This asset does not currently use typed BooleanExpr predicates under
#   `when:`; flow control is branch-label-driven (`on_resume`, `on_fresh`,
#   `on_restart`, etc.). Retain the existing shape.
# - `after:` carries prose timing / narrative notes if needed; `when:` in
#   this file is reserved for future typed predicates and must NOT carry
#   free-form narrative prose.
# - See `.skilled/skills/system-spec-kit/shared/predicates/boolean-expr.ts`
#   for the canonical BooleanExpr grammar.
#
# GATE 3 CLASSIFICATION (T-YML-DPR-01 / paired with T-DOC-03 R50-001):
# - `resume` is a tested WRITE-PATH that produces `iteration-NNN.md` files
#   and JSONL state-log appends. The workflow classifies resume as
#   write-path below (see `gate3_classification` fields) so Gate 3 trigger
#   extraction can surface resume correctly rather than false-negative.
# ─────────────────────────────────────────────────────────────────
role: Deep Research Loop Manager
purpose: Iterative deep research with convergence detection
action: Run deep-research loop from initialization through synthesis
operating_mode:
  workflow: iterative_loop
  workflow_compliance: MANDATORY
  workflow_execution: autonomous
  approvals: none
  tracking: progressive_research_state
  validation: convergence_detection

# ─────────────────────────────────────────────────────────────────
# OPERATING PRINCIPLES
# ─────────────────────────────────────────────────────────────────
operating_principles:
  core: "Fresh context per iteration + externalized state = no context degradation"
  approach: "Dispatch focused agent, evaluate convergence, repeat or stop"
  mandate: "Never hold findings in memory; write everything to files"

# ─────────────────────────────────────────────────────────────────
# USER INPUTS (from setup phase)
# ─────────────────────────────────────────────────────────────────
user_inputs:
  research_topic: "[RESEARCH_TOPIC] - Topic to investigate deeply. REQUIRED."
  spec_folder: "[SPEC_FOLDER] - Spec folder path. REQUIRED."
  max_iterations: "[MAX_ITERATIONS] - Maximum loop iterations. Default: 10."
  convergence_threshold: "[CONVERGENCE_THRESHOLD] - Stop threshold. Default: 0.05."
  convergence_mode: "[default|off|sliding-window|divergent] - Convergence policy modifier. Default: default."
  stop_policy: "[convergence|max-iterations] - Convergence stop policy; max-iterations forces the loop to run every iteration. Default: convergence."

# ─────────────────────────────────────────────────────────────────
# CONTEXT LOADING
# ─────────────────────────────────────────────────────────────────
context_loading:
  trigger: "At workflow START, before phase_init"
  purpose: "Load prior research context for the topic and buffer it until strategy.md exists"
  retrieval:
    mechanism: "continuity-ladder-then-ripgrep"
    note: "File reads only. Nothing here needs a running daemon, and every step is reproducible by hand."
    ladder:
      - "{spec_folder}/handover.md when present"
      - "the _memory.continuity frontmatter block in {spec_folder}/implementation-summary.md"
      - "the packet's canonical spec docs, spec.md and decision-record.md, for what the first two steps leave open"
    free_text_recipe: "rg --no-config --json --fixed-strings --ignore-case -C 2 --glob '*.md' --glob '!**/z_archive/**' --glob '!**/node_modules/**' -- '{research_topic}' specs .skilled"
    recipe_contract: ".skilled/skills/system-spec-kit/references/retrieval/retrieval-conventions.md"
    exit_status: "0 is a hit set, 1 is a clean no-hit, 2 or higher is a failure that must be surfaced instead of reported as no-hit"
    ranking: "Ripgrep does not rank. Order the hits caller-side with the tuple in retrieval-conventions.md section 5."
  when_to_skip: ["User says 'skip context' or 'fresh start'"]
  behavior:
    if_context_found: "Store full results as prior_context plus a concise prior_context_summary; inject after strategy.md is created."
    if_no_context: "Set prior_context and prior_context_summary to 'None' and continue."

# ─────────────────────────────────────────────────────────────────
# SKILL REFERENCE
# ─────────────────────────────────────────────────────────────────
skill_reference:
  skill: system-deep-loop
  skill_md: .skilled/skills/system-deep-loop/deep-research/SKILL.md
  references:
    loop_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/loop-protocol.md
    spec_check_protocol: .skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md
    state_format: .skilled/skills/system-deep-loop/deep-research/references/state/state-format.md
    convergence: .skilled/skills/system-deep-loop/deep-research/references/convergence/convergence.md
  templates:
    config: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json
    strategy: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md

# ─────────────────────────────────────────────────────────────────
# AGENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────
agent_config:
  agent: deep-research
  agent_file: ".skilled/agents/deep-research.md"
  # Canonical path. Runtime-specific directories (e.g. .claude/agents/) reference this source.
  model: opus
  leaf_only: true
  tools: [Read, Write, Edit, Bash, Grep, Glob, WebFetch]
  mcp_servers: []
  tool_call_budget: { target: 12, max: 24 }

# ─────────────────────────────────────────────────────────────────
# STATE FILE PATHS
# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# CANONICAL STATE WRITE MECHANISM
# ─────────────────────────────────────────────────────────────────
state_write_protocol:
  mechanism: "append-gateway"
  command: "node .skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs --mode research --run-directory {artifact_dir} --event-json <record file>"
  applies_to: "every append_to_jsonl and append_jsonl directive in this workflow"
  refusal_handling: "halt on exit 2; never fall back to a direct file write. Exit 1 on a row that is still routed through the gateway is a workflow defect and halts; the pinned_bookkeeping rows are recorded through bookkeeping_log and are never routed."
  pinned_bookkeeping:
    events: [config_warning, graph_convergence, lock_released, migration, min_iterations_guard_pass, stuckRecovery]
    directive: "bookkeeping_log"
    handling: "These rows are workflow bookkeeping that the research ledger schema pins to the legacy path: they have no lossless research-event target, so the gateway would refuse them with exit 1 and write nothing. They are never sent to the gateway. The step prints the row in its log line and continues; none of them is a halt condition."
  contract: |
    The directives below specify WHAT to record; this block specifies the mechanism. The
    command accepts a canonical event envelope — a `stem` with `scope` and `data`, or an
    `event_type` with a `payload` — and for this mode it also accepts a legacy-shaped row,
    which it upcasts before appending. Where the upcast is lossy it returns a warning, and
    the warning is surfaced rather than swallowed. Some directives below record workflow
    bookkeeping rather than research semantics: the schema deliberately pins several of them
    to the legacy path and the upcaster has no registered stem for the rest. Those rows are
    declared under pinned_bookkeeping and recorded through bookkeeping_log, so they are never
    routed here. A refusal names its own reason, so the caller can tell a deliberate pin from
    a missing stem. A row the upcaster does refuse returns exit 1 and writes nothing, with the
    reason naming why. Exit 1 is distinct from the exit 2 refusal described in the next
    paragraph: exit 1 means the input never reached authority, exit 2 means authority refused
    it.

    The gateway authorizes the write against the mode's durable authority record, serialises it
    behind the ledger fence, returns a receipt, and refreshes state_log from the ledger. Exit 0
    means the record is durable. Exit 2 means it was refused, and the refusal names the check
    that failed.

    Writing state_log directly bypasses ordering, authorization, and the receipt. Two writers
    can then interleave with no shared ordering, and a record nobody authorized carries no
    receipt, so a later reader cannot tell an accepted record from an invented one. A refusal
    is a halt, never a reason to write the file directly.

    There is no direct-append exception. The run-now sentinels, the restored-sentinel row and
    the synthesis reconciliation rows are canonical ledger events, because state_log is a
    projection the gateway rebuilds from the ledger and a row written beside it is dropped by
    the next refresh.

state_paths:
  # Template paths document the canonical packet layout. Runtime resolution happens via
  # step_resolve_artifact_root plus the shared resolver, so root specs keep root-local
  # research/ and child phases keep local research/ packet directories.
  packet_dir: "{artifact_dir}"
  config: "{artifact_dir}/deep-research-config.json"
  state_log: "{artifact_dir}/deep-research-state.jsonl"
  status_ledger: "{artifact_dir}/orchestration-status.log"
  strategy: "{artifact_dir}/deep-research-strategy.md"
  registry: "{artifact_dir}/findings-registry.json"
  dashboard: "{artifact_dir}/deep-research-dashboard.md"
  pause_sentinel: "{artifact_dir}/.deep-research-pause"
  run_now_sentinel: "{artifact_dir}/.deep-research-run-now"
  lock_file: "{artifact_dir}/.deep-research.lock"
  prompt_dir: "{artifact_dir}/prompts"
  iteration_dir: "{artifact_dir}/iterations"
  iteration_pattern: "{artifact_dir}/iterations/iteration-{NNN}.md"
  # Per-iteration structured delta stream (one file per iteration) — complement to the
  # canonical state_log append. The delta file MUST contain at least one record whose
  # `type === "iteration"` so the reducer can rehydrate iteration state after a partial
  # run. Variants like `"iteration_delta"` are silently dropped by the reducer; the
  # post_dispatch_validate step enforces the canonical type below.
  delta_dir: "{artifact_dir}/deltas"
  delta_pattern: "{artifact_dir}/deltas/iter-{NNN}.jsonl"
  research_output: "{artifact_dir}/research.md"
  resource_map_output: "{artifact_dir}/resource-map.md"
  archive_root: "{artifact_archive_root}"
  synthesis_snapshot_pattern: "{artifact_dir}/synthesis-v{generation}.md"

# ─────────────────────────────────────────────────────────────────
# WORKFLOW
# ─────────────────────────────────────────────────────────────────
workflow:

  step_resolve_artifact_root:
    description: "Resolve artifact directory — use fan-out lineage override when provided, else resolve from spec_folder"
    note: "Root specs keep research artifacts directly in {spec_folder}/research/. Child phases and sub-phases keep local packet directories in {spec_folder}/research/{packet}/, and archives stay local at {spec_folder}/research_archive/{packet}/."
    branch_on: "config.fanout_lineage_artifact_dir"
    if_present:
      bind:
        artifact_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_root_dir: "{config.fanout_lineage_artifact_dir}"
        artifact_subfolder: null
        artifact_archive_root: "{config.fanout_lineage_artifact_dir}/_archive"
    if_absent:
      command: "node -e \"const { resolveArtifactRoot } = require('./.skilled/skills/system-spec-kit/shared/review-research-paths.cjs'); console.log(JSON.stringify(resolveArtifactRoot('{spec_folder}', 'research')));\""
      outputs:
        - artifact_root_dir: "Resolved local research owner directory"
        - artifact_subfolder: "Local packet subfolder ({ownerSlug}-pt-{NN}), else null"
        - artifact_dir: "Resolved research packet directory for this target"
        - artifact_archive_root: "Resolved local research archive directory for this target"

  step_fanout_spawn:
    description: "Spawn fan-out lineages; skip and proceed to phase_init normally when single-executor"
    skip_when: "config.fanout is absent"
    instructions: |
      Fan-out mode is active. Spawn all lineages. Each lineage runs the full loop in its own
      isolated sub-packet under {artifact_dir}/lineages/{label}/.
      fanout-run.cjs owns native and CLI lineage execution; native is run through the
      deep/research command surface with config.fanout_lineage_artifact_dir so the LEAF
      deep-research agent is used only for individual iterations, never as a full-loop
      sub-agent or pasted phase-running prompt.
      After all lineages complete, jump directly to phase_synthesis — skip phase_init and
      phase_main_loop entirely (those are the single-executor path). The merge step in
      phase_synthesis will consolidate results across all lineages.
    sub_steps:
      step_fanout_spawn_cli:
        description: "Spawn all native and CLI lineages in capped worker pool"
        skip_when: "no entries in config.fanout.executors"
        command: |
          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs \
            --spec-folder {spec_folder} \
            --loop-type research \
            --research-topic "{research_topic}" \
            --fanout-config-json '{config.fanout_json}' \
            --base-artifact-dir {artifact_dir} \
            --convergence-threshold {convergence_threshold} \
            --stop-policy {stop_policy} \
            --convergence-mode {convergence_mode}
        working_directory: "{repo_root}"
        wait_for_completion: true

  # ═══════════════════════════════════════════════════════════════
  # PHASE 1: INITIALIZATION
  # ═══════════════════════════════════════════════════════════════
  phase_init:
    purpose: Create all state files for the research session
    steps:

      step_preflight_contract:
        action: "Validate required setup bindings and executable workflow contract before any file writes"
        verify:
          - required_values_present: [research_topic, spec_folder, max_iterations, convergence_threshold, convergence_mode, stop_policy]
          - spec_folder_is_within: "specs/ or .opencode/specs/ (canonicalize alias roots before validation)"
          - unresolved_placeholders: "FAIL if any user-facing template references placeholders not produced by earlier steps"
          - tool_contract: "FAIL if executable steps reference tools outside the command allowlist"
        on_fail: "Halt with STATUS=FAIL and report the missing binding or unsupported contract reference"

      step_create_directories:
        action: "Create spec folder and research packet directories if they don't exist"
        command: "mkdir -p {state_paths.prompt_dir} {state_paths.iteration_dir} {state_paths.delta_dir}"

      step_detect_resource_map:
        action: "Detect resource-map.md before config creation so init can persist the flag and seed Known Context"
        inspect:
          - "{spec_folder}/resource-map.md"
        classify:
          present: "resource-map.md exists at init"
          absent: "resource-map.md does not exist at init"
        outputs:
          - resource_map_present: "Boolean true when {spec_folder}/resource-map.md exists, else false"
          - resource_map_known_context: "When present: summarize the map by section with entry counts across READMEs, Documents, Commands, Agents, Skills, Specs, Scripts, Tests, Config, and Meta, plus a one-line theme summary for each section. When absent: 'resource-map.md not present; skipping coverage gate'."

      step_resolve_canonical_names:
        action: "Resolve canonical research packet artifact names before classification"
        inspect_legacy:
          - "{state_paths.packet_dir}/config.json"
          - "{state_paths.packet_dir}/state.jsonl"
          - "{state_paths.packet_dir}/strategy.md"
          - "{state_paths.packet_dir}/dashboard.md"
          - "{state_paths.packet_dir}/.pause"
        migration_policy: "dual-read / single-write for 4 weeks"
        on_legacy_read:
          bookkeeping_log: '{"type":"event","event":"migration","legacyPath":"{legacy_path}","canonicalPath":"{canonical_path}","timestamp":"{ISO_8601_NOW}"}'

      step_acquire_lock:
        action: "Acquire the single-writer advisory lock before session classification"
        command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs acquire --lock-path {state_paths.lock_file} --packet-id {spec_folder}"
        on_acquire: "Capture lock.ownerPid as captured_owner_pid and lock.acquireNonce as captured_acquire_nonce from the JSON output, and reuse both for every release below. If acquired=false, fail closed: another deep-research run already holds this packet."
        note: "Uses the promoted runtime/ loop-lock CLI (single source of truth: stale-lock reclaim, clean owner-scoped release). macOS/BSD locking is advisory — best-effort single-writer, not a hard mutex across host calls; stale-lock override is confirm-only or explicit recovery-only."
        # Lock-cleanup contract: the lock file MUST be released on every terminal exit path that follows acquisition.
        # Runtimes honoring step_acquire_lock are required to perform this cleanup before halting or pausing.
        on_halt:
          action: "Release the lock before any terminal halt branch returns control"
          applies_to: ["step_classify_session.on_invalid_state", "step_classify_session.on_completed_session", "step_preinit_spec_branch.conflict-detected"]
          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; failures here are logged but do not block the halt"
        on_cancel:
          action: "Release the lock on user cancel or pause-sentinel detection before sentinel processing"
          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; cancel completes regardless of cleanup result"
        on_workflow_exit:
          action: "Release the lock as the final step of any workflow exit path (success or failure)"
          command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}; idempotent, safe to invoke when already released"

      step_classify_session:
        action: "Classify the session before writing files"
        inspect:
          - "{state_paths.config}"
          - "{state_paths.state_log}"
          - "{state_paths.strategy}"
        classify:
          fresh: "None of the three state artifacts exist"
          resume: "Config, JSONL, and strategy all exist and agree on topic/spec folder; missing wait-checkpoint fields are read as nextRunAt:null and remainingDelayMs:null"
          completed-session: "Resume artifacts exist and config.status == 'complete'"
          invalid-state: "Any partial, missing, or contradictory combination"
        outputs:
          - session_state: "fresh | resume | completed-session | invalid-state"
        on_resume:
          # T-YML-DPR-01 / R50-001: Resume is a WRITE-PATH. Produces `iteration-NNN.md` + JSONL appends.
          # Paired with T-DOC-03 Gate 3 trigger addition (resume, save context, save memory, /speckit:save).
          gate3_classification: write-path
          gate3_rationale: "resume produces iteration-NNN.md writes and JSONL state-log appends"
          log: "Auto-resume: state artifacts are complete and consistent. Continue the same lineage (sessionId unchanged, generation unchanged, no archive)."
          append_jsonl: '{"type":"event","event":"resumed","mode":"research","sessionId":"{session_id}","parentSessionId":"{session_id}","lineageMode":"resume","continuedFromRun":{iteration_count},"generation":{generation},"archivedPath":null,"timestamp":"{ISO_8601_NOW}"}'
          skip_to: phase_loop
        on_restart:
          action: "Archive the current research packet under the root-level research_archive/ tree and start a new lineage segment with a fresh sessionId and generation+1."
          command: "if [ -d {state_paths.packet_dir} ]; then mkdir -p {state_paths.archive_root} && mv {state_paths.packet_dir} {state_paths.archive_root}/{timestamp_slug}; fi"
          set:
            lineage_mode: "restart"
            parent_session_id: "{prior_session_id}"
            generation: "{prior_generation + 1}"
          append_jsonl: '{"type":"event","event":"restarted","mode":"research","sessionId":"{session_id}","parentSessionId":"{prior_session_id}","lineageMode":"restart","generation":{generation},"archivedPath":"{state_paths.archive_root}/{timestamp_slug}","timestamp":"{ISO_8601_NOW}"}'
          skip_to: step_create_config
        note_deferred_branches: "fork and completed-continue are deferred and no longer runtime-supported in this release. The reducer still reads `lineageMode` from config for dashboards and analysis, but only `new`, `resume`, and `restart` are live. See deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract for the one-session contract."
        on_completed_session:
          log: "Prior session already completed. Do not route directly to synthesis; archive the completed research/ tree or start a fresh packet instead."
          halt: true
          message: "Completed deep-research packet detected. Archive or replace the existing research/ tree before starting a new session."
        on_invalid_state:
          halt: true
          message: "Existing deep-research state is incomplete or contradictory. Repair or archive the invalid research packet before continuing."
        on_fresh:
          action: "Proceed with a new session"

      step_resolve_session_id:
        action: "Resolve init session id from caller when supplied, else preserve the auto-generated fallback"
        branch_on: "session_id"
        if_present:
          bind:
            session_id_init: "{session_id}"
        if_absent:
          bind:
            # The token is bound here so the fallback literal resolves to a real timestamp when no caller session_id is supplied.
            AUTO_SESSION_ID: "{ISO_8601_NOW}"
            session_id_init: "{AUTO_SESSION_ID}"

      step_create_config:
        action: "Create deep-research-config.json from template"
        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-config.json
        populate:
          topic: "{research_topic}"
          maxIterations: "{max_iterations}"
          minIterations: 3
          # Semantic: newInfoRatio with negative-knowledge emphasis. See SKILL.md §"Convergence Threshold Semantics".
          convergenceThreshold: "{convergence_threshold}"
          stopPolicy: "{stop_policy}"
          antiConvergence.convergenceMode: "{convergence_mode}"
          antiConvergence.divergent: {}
          stuckThreshold: 3
          minIdeaObservations: 2
          maxDurationMinutes: 120
          specFolder: "{spec_folder}"
          resource_map_present: "{resource_map_present}"
          # Honor the parsed --no-resource-map flag from deep-research.md:73 (default true; false when flag is set).
          # The markdown command parses $ARGUMENTS and binds {resource_map_emit} before this step runs.
          resource_map.emit: "{resource_map_emit}"
          createdAt: "{ISO_8601_NOW}"
          status: "initialized"
          executionMode: "auto"
          lineage.sessionId: "{session_id_init}"
          lineage.parentSessionId: null
          lineage.lineageMode: "new"
          lineage.generation: 1
          lineage.continuedFromRun: null
          nextRunAt: null
          remainingDelayMs: null
        output: "{state_paths.config}"

      step_create_state_log:
        action: "Open the research run by appending deep_research.run_initialized through the gateway"
        note: |
          The state log is a projection rebuilt by the gateway. Recording the run's opening in
          the ledger gives every later state append the same authorized, ordered source.
        command: |
          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
          EVENT_FILE="$(mktemp "${TMPDIR:-/tmp}/deep-research-run-open.XXXXXX")"
          node -e '
            const fs = require("fs"), crypto = require("crypto");
            const [configPath] = process.argv.slice(1);
            const raw = fs.readFileSync(configPath);
            const config = JSON.parse(raw);
            const sha = (value) => crypto.createHash("sha256").update(value).digest("hex");
            const lineage = config.lineage || {};
            const sessionId = lineage.sessionId;
            const lineageId = lineage.parentSessionId || sessionId;
            const generation = Number(lineage.generation) || 1;
            const configDigest = sha(raw);
            const event = {
              stem: "deep_research.run_initialized",
              scope: { runId: sessionId, lineageId },
              data: {
                generation,
                charterDigest: sha(Buffer.from(JSON.stringify({
                  topic: config.topic,
                  specFolder: config.specFolder || "",
                }))),
                configDigest,
                executorFingerprint: sha(Buffer.from(JSON.stringify(config.executor || {}))),
                replayFingerprint: sha(Buffer.from(JSON.stringify({
                  runId: sessionId,
                  lineageId,
                  generation,
                  configDigest,
                }))),
                maxIterations: Number(config.maxIterations),
                convergencePolicyVersion: "convergence-policy@" + (
                  (config.antiConvergence && config.antiConvergence.convergenceMode) || "default"
                ),
              },
            };
            process.stdout.write(JSON.stringify(event));
          ' "{state_paths.config}" > "$EVENT_FILE" || { rm -f "$EVENT_FILE"; exit 1; }
          node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$EVENT_FILE"
          STATUS=$?
          rm -f "$EVENT_FILE"
          exit "$STATUS"
        output: "{state_paths.state_log}"

      step_create_strategy:
        action: "Create strategy file from template with initial questions"
        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-strategy.md
        populate:
          topic: "{research_topic}"
          key_questions: "Derive 3-5 key questions from the research topic"
          known_context: "None"
          known_context_summary: "None"
          max_iterations: "{max_iterations}"
          convergence_threshold: "{convergence_threshold}"
        output: "{state_paths.strategy}"

      step_create_registry:
        action: "Initialize reducer-owned findings registry"
        content: '{"openQuestions":[],"resolvedQuestions":[],"keyFindings":[],"ruledOutDirections":[],"metrics":{"iterationsCompleted":0,"openQuestions":0,"resolvedQuestions":0,"keyFindings":0,"convergenceScore":0,"coverageBySources":{}}}'
        output: "{state_paths.registry}"

      step_enrich_strategy_context:
        action: "Ensure Known Context is written only after strategy.md exists"
        condition: "prior_context_found"
        edit: "{state_paths.strategy}"
        note: "Append or replace the Known Context section with prior_context_summary and retained detail from prior_context"

      step_enrich_strategy_resource_map:
        action: "Inject resource-map status into Known Context after strategy.md exists"
        edit: "{state_paths.strategy}"
        note: "When resource_map_present is true, append the resource_map_known_context snapshot. When false, append 'resource-map.md not present; skipping coverage gate'."

      step_detect_spec_present:
        action: "Classify late-INIT spec.md state after the durable research packet exists"
        inspect:
          - "{spec_folder}/spec.md"
          - "{state_paths.lock_file}"
        classify:
          no-spec: "spec.md is absent before any pre-init mutation"
          spec-present: "spec.md exists and approved host anchors are available for bounded mutation"
          spec-just-created-by-this-run: "spec.md already carries this run's DR seed markers and should not be reseeded"
          conflict-detected: "missing host anchor, duplicate markers, or generated-block ambiguity makes mutation unsafe"
        outputs:
          - folder_state: "no-spec | spec-present | spec-just-created-by-this-run | conflict-detected"
          - normalized_topic: "Trim, lowercase, and collapse whitespace in research_topic before dedupe checks"
        append_to_jsonl: '{"type":"event","event":"spec_check_result","folder_state":"{folder_state}","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","lockPath":"{state_paths.lock_file}","timestamp":"{ISO_8601_NOW}"}'

      step_preinit_spec_branch:
        action: "Run the bounded pre-init spec branch required by spec_check_protocol"
        protocol_reference: ".skilled/skills/system-deep-loop/deep-research/references/protocol/spec-check-protocol.md"
        branches:
          no-spec:
            create: "{spec_folder}/spec.md"
            seed_markers:
              - "<!-- DR-SEED:REQUIREMENTS -->"
              - "<!-- DR-SEED:SCOPE -->"
            requirements_host: "Seed Requirements from the research ask without broadening scope"
            scope_host: "Seed Scope from the research ask without inventing implementation details"
            set:
              folder_state: "spec-just-created-by-this-run"
              validate_spec_doc: true
            append_to_jsonl: '{"type":"spec_mutation","event":"spec_seed_created","folder_state":"spec-just-created-by-this-run","anchors_touched":["Requirements","Scope"],"diff_summary":"Seeded Level 1 spec.md from research topic with DR seed markers.","seed_markers":["DR-SEED:REQUIREMENTS","DR-SEED:SCOPE"],"timestamp":"{ISO_8601_NOW}"}'
          spec-present:
            edit: "{spec_folder}/spec.md"
            set:
              validate_spec_doc: true
            idempotency_check:
              host_anchor: "Open Questions"
              normalized_match: "Normalize the existing anchor text by lowercasing, stripping punctuation, collapsing whitespace, and trimming before comparing with {normalized_topic}."
              if_match:
                skip_append: true
                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_deduped","folder_state":"spec-present","anchors_touched":["Open Questions"],"diff_summary":"Skipped duplicate pre-init topic append because normalized topic already exists in Open Questions.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
              if_no_match:
                append_only:
                  - host_anchor: "Open Questions"
                    content: "Add the normalized research topic only if it is not already present."
                  - host_anchor: "Research Context"
                    content: "Add a bounded note that deep-research is active for this topic and that research/research.md remains canonical."
                append_to_jsonl: '{"type":"spec_mutation","event":"spec_preinit_context_added","folder_state":"spec-present","anchors_touched":["Open Questions","Research Context"],"diff_summary":"Appended bounded pre-init research context for the normalized topic.","normalized_topic":"{normalized_topic}","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
          spec-just-created-by-this-run:
            verify_markers:
              - "<!-- DR-SEED:REQUIREMENTS -->"
              - "<!-- DR-SEED:SCOPE -->"
            set:
              validate_spec_doc: false
            note: "Treat already-seeded spec.md as a no-op guard and continue."
          conflict-detected:
            append_to_jsonl: '{"type":"spec_mutation","event":"spec_mutation_conflict","folder_state":"conflict-detected","reason":"Pre-init spec.md mutation is ambiguous or unsafe.","specPath":"{spec_folder}/spec.md","timestamp":"{ISO_8601_NOW}"}'
            halt: true

      step_validate_preinit_spec_doc:
        action: "Run targeted strict validation after any deep-research pre-init spec.md mutation"
        condition: "validate_spec_doc"
        command: "SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict"
        note: "This enforces the authored-spec markdown structural contract without applying full-packet required-file or completeness checks to workflow-owned research artifacts. It uses the Node validation orchestrator, whose strict path was measured at about 108ms for a fresh Level 3 packet on the local harness."

      step_telemetry_heartbeat_started:
        action: "Emit a single-loop started row in the orchestration status ledger"
        skip_when: "config.fanout is present"
        canonical_lifecycle_event: "iteration_start"
        command: |
          node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
          import { readFileSync } from 'node:fs';

          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';
          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';

          const { appendObservabilityEvent } = observabilityEvents;
          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));
          const timestamp = '{ISO_8601_NOW}';
          const sessionId = String(config.lineage?.sessionId ?? '{AUTO_SESSION_ID}');
          const generation = Number(config.lineage?.generation ?? 1);
          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';
          const row = {
            event: 'started',
            label: 'single',
            at: timestamp,
            duration_ms: 0,
            loop_type: 'research',
            sessionId,
            generation,
            gauges: { iterations: 0, elapsed_ms: 0, score: 0 },
          };

          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {
            diffData: { event: row.event, label: row.label, sessionId, generation, gauges: { iterations: 0, score: 0 } },
            diffField: 'state_hash',
          });
          if (appended) {
            try {
              appendObservabilityEvent(observabilityPath, row, {
                producer: 'deep-research-auto',
                stream: 'single-loop-telemetry',
                subject: { label: row.label, sessionId, generation },
                event: row.event,
                status: 'running',
              });
            } catch {}
          }
          EOF
        working_directory: "{repo_root}"
        outputs:
          - status_ledger_started: "A fan-out-shaped status row with label single and event started"

      step_init_complete:
        log: "Initialization complete. Config, state, and strategy files created."
        set: { current_iteration: 1, current_segment: 1, stuck_count: 0 }

  # ═══════════════════════════════════════════════════════════════
  # PHASE 2: ITERATION LOOP
  # ═══════════════════════════════════════════════════════════════
  phase_loop:
    purpose: Dispatch agent iterations until convergence
    repeat: true
    max_repeats: "{max_iterations}"
    steps:

      step_read_state:
        action: "Read current state from JSONL and strategy"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.strategy}"
          - "{state_paths.config}"
        extract:
          - iteration_count: "Count lines where type === 'iteration'"
          - current_iteration: "iteration_count + 1"
          - current_segment: "Latest segment_start event segment, else 1"
          - last_newInfoRatio: "Extract newInfoRatio from last iteration record"
          - last_focus: "Extract focus from latest iteration record, else 'none yet'"
          - ratio_prev: "Extract newInfoRatio from second-latest iteration record, else 'N/A'"
          - ratio_latest: "Extract newInfoRatio from latest iteration record, else 'N/A'"
          - next_focus: "Extract 'Next Focus' section from strategy.md"
          - remaining_questions: "Count unchecked items in 'Key Questions'"
          - remaining_questions_list: "List unchecked key questions from strategy.md"
          - carried_forward_open_questions: "Extract 'Carried-Forward Open Questions' section from strategy.md, else '[None yet]'"
          - answered_count: "Count answered questions from strategy.md"
          - total_questions: "Count total questions tracked in strategy.md"
          - resource_map_present: "Extract boolean from deep-research-config.json, default false"
          - resource_map_prompt_line: "If resource_map_present is true, return 'Resource map: prior-inventoried files are listed in {spec_folder}/resource-map.md; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.' Else return 'Resource map: resource-map.md not present; skipping coverage gate.'"
          - lineage_context_prompt_line: "If a refreshed lineage context summary exists from the previous iteration, return 'Lineage context refresh: {summary}'. Else use prior_context_summary from startup when available; otherwise return 'Lineage context refresh: none loaded yet.'"
          - least_explored: "First unanswered question not covered by the most recent iteration focus, else first unanswered question"
          - last_3_summaries: "Summarize the latest 3 iteration records as 'run N: focus (ratio)'"
          - latest_status: "Extract status from latest iteration record, else 'none yet'"
          - nextRunAt: "Extract nullable nextRunAt from deep-research-config.json, default null"
          - remainingDelayMs: "Extract nullable remainingDelayMs from deep-research-config.json, default null"
          - min_iterations_present: "Boolean true when deep-research-config.json has a numeric minIterations field"
          - min_iterations_missing_warning: "Boolean true when minIterations is missing; use no floor and log a warning so older configs keep prior stop behavior"
          - min_iterations_raw: "Extract numeric minIterations from deep-research-config.json when present, default 0"
          - effective_min_iterations: "Clamp min_iterations_raw to the inclusive range 0..max_iterations; if min_iterations_raw exceeds max_iterations, use max_iterations"
          - min_iterations_clamped: "Boolean true when min_iterations_raw > max_iterations"
          - min_iterations_guard_already_passed: "Boolean true when the floor had already cleared before this iteration: iteration_count - 1 >= effective_min_iterations"
          - convergence_mode: "Extract antiConvergence.convergenceMode when it is one of 'default', 'off', 'sliding-window', or 'divergent'; default to 'default'"
          - stop_policy: "Extract stopPolicy from deep-research-config.json, default 'convergence'. Valid values: convergence, max-iterations."
          - convergence_mode_warning: "Boolean true when antiConvergence.convergenceMode is present with an unsupported value; use 'default'"
          - rejected_patterns_count: "Read registry.rejectedPatterns length when registry exists, else 0"
          - rejected_candidate_matches: "Read registry.suppressedCandidates when registry exists, else []"
          - rejected_pattern_fuzzy_threshold: "Read config.rejectedPatternFuzzyThreshold when present, else 0.85"
          - min_idea_observations: "Read config.minIdeaObservations when present, default 2; clamp to 1..10"
          - observed_ideas_count: "Read registry.observedIdeas length when registry exists, else 0"
          - promoted_ideas_count: "Read registry.promotedIdeas length when registry exists, else 0"
          - promoted_ideas_list: "Read registry.promotedIdeas idea text in rank order when registry exists, else []"
          - suppressed_ideas_count: "Read registry.suppressedIdeas length when registry exists, else 0"
          - pivot_lineage: "Summarize registry.divergence.completed and registry.divergence.overrides with pivot ids, source iterations, and selected focus; else 'none yet'"
          - saturated_directions: "List registry.divergence.saturatedDirections; else 'none yet'"

      step_run_now_check:
        action: "Detect and consume a one-shot run-now sentinel before pause/convergence/dispatch"
        command: |
          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
          EVENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX")"
          node - "$EVENT_DIR" <<'EOF'
          const { existsSync, renameSync, unlinkSync, writeFileSync } = require('node:fs');
          const { join } = require('node:path');

          const eventDir = process.argv[2];
          const sentinelPath = "{state_paths.run_now_sentinel}";
          const pausePath = "{state_paths.pause_sentinel}";
          const sessionId = "{config.lineage.sessionId}";
          const generation = Number("{config.lineage.generation}");
          const run = Number("{current_iteration}");

          // The state log is a projection the gateway rebuilds from the ledger, so a
          // run-now row is staged as a canonical ledger event and appended by the
          // gateway; a write beside the projection is dropped by the next refresh.
          // The loop boundary has no lineage identity yet, so the session names both
          // scope halves rather than inventing a second identifier.
          const scope = { runId: sessionId, lineageId: sessionId };

          let sequence = 0;

          function record(event, fields) {
            sequence += 1;
            writeFileSync(
              join(eventDir, `${String(sequence).padStart(2, "0")}-${event}.json`),
              JSON.stringify({
                stem: `deep_research.${event}`,
                scope,
                data: { mode: "research", run, sessionId, generation, ...fields },
              }),
              "utf8",
            );
          }

          if (existsSync(sentinelPath)) {
            record("run_now_requested", { sentinelPath });
            if (existsSync(pausePath)) {
              record("run_now_rejected", {
                sentinelPath,
                reason: "loop_paused",
                pauseSentinelPath: pausePath,
              });
            } else {
              const claimPath = `${sentinelPath}.consuming.${process.pid}.${Date.now()}`;
              try {
                renameSync(sentinelPath, claimPath);
                unlinkSync(claimPath);
                record("run_now_accepted", {
                  sentinelPath,
                  dispatchEvent: "iteration_start",
                });
              } catch (error) {
                if (!error || error.code !== "ENOENT") {
                  throw error;
                }
              }
            }
          }
          EOF
          for eventFile in "$EVENT_DIR"/*.json; do
            [ -e "$eventFile" ] || continue
            node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$eventFile"
            GATEWAY_STATUS=$?
            if [ "$GATEWAY_STATUS" -ne 0 ]; then
              rm -rf "$EVENT_DIR"
              exit "$GATEWAY_STATUS"
            fi
          done
          rm -rf "$EVENT_DIR"
        outputs:
          - run_now_requested: "Emitted when {state_paths.run_now_sentinel} exists at the loop boundary"
          - run_now_accepted: "Emitted after the sentinel is atomically renamed and deleted before dispatch"
          - run_now_rejected: "Emitted with reason loop_paused when pause takes precedence; sentinel remains present"

      step_check_pause_sentinel:
        action: "Check for pause sentinel file"
        check: "Does {state_paths.pause_sentinel} exist?"
        if_exists:
          log_event: '{"type":"event","event":"userPaused","mode":"research","run":{current_iteration},"stopReason":"userPaused","sentinelPath":"{state_paths.pause_sentinel}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          message: "Research paused. Delete research/.deep-research-pause to resume."
          halt: true
        if_not_exists:
          proceed: true

      step_validate_convergence_config:
        action: "Validate convergence floor settings when loading config"
        if_min_iterations_missing:
          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"minIterations","fallback":0,"message":"minIterations missing; using no convergence floor for backward compatibility.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "minIterations missing; using no convergence floor for backward compatibility."
        if_min_iterations_clamped:
          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"minIterations","configured":{min_iterations_raw},"effective":{effective_min_iterations},"maxIterations":{max_iterations},"message":"minIterations exceeds maxIterations; clamping to the hard cap.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "minIterations exceeds maxIterations; clamping to the hard cap."
        if_convergence_mode_invalid:
          bookkeeping_log: '{"type":"event","event":"config_warning","mode":"research","field":"convergenceMode","fallback":"default","message":"Unsupported convergenceMode; using default convergence behavior.","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "Unsupported convergenceMode; using default convergence behavior."

      step_graph_convergence:
        action: "Evaluate coverage-graph convergence before the inline 3-signal vote and persist the graph decision snapshot"
        bash: 'node .skilled/skills/system-deep-loop/runtime/scripts/convergence.cjs --spec-folder "{spec_folder}" --loop-type "research" --session-id "{config.lineage.sessionId}" --convergence-mode "{convergence_mode}" --persist-snapshot --iteration "{current_iteration}"'
        note: "Run before the inline vote. STOP from the inline 3-signal vote is allowed only when the graph decision is STOP_ALLOWED or absent."
        outputs:
          - graph_decision: "Tool decision value (CONTINUE | STOP_ALLOWED | STOP_BLOCKED), else null when unavailable"
          - graph_decision_json: "JSON-encoded graph decision string, else null"
          - graph_signals_json: "Tool signals object, else {}"
          - graph_blockers_json: "Tool blockers array, else []"
          - graph_trace_json: "Tool trace payload, else []"
          - graph_convergence_score: "signals.blendedScore when present, else the best available graph score, else 0"
        bookkeeping_log: '{"type":"event","event":"graph_convergence","mode":"research","run":{current_iteration},"decision":{graph_decision_json},"signals":{graph_signals_json},"blockers":{graph_blockers_json},"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'

      step_check_convergence:
        action: "Evaluate stop conditions and combine the inline 3-signal vote with graph convergence"
        algorithm: |
          1. if iteration_count >= max_iterations: STOP (maxIterationsReached). This terminal cap bypasses quality-guard overrides; record failed guards/blockers as synthesis evidence instead of continuing.
          2. if stuck_count >= config.stuckThreshold: STUCK_RECOVERY
          3. if convergence_mode == "off": skip convergence stop candidates and continue unless a terminal cap, pause sentinel, or recovery halt has already fired.
          3a. if stop_policy == "max-iterations" AND iteration_count < max_iterations: steps 4 and 5 are telemetry only and cannot set STOP or BLOCKED. Record weighted_stop_score for diagnostics, keep decision = "CONTINUE" and choose a broader next focus.
          4. if remaining_questions == 0: STOP (all_questions_answered)
          5. GRAPH-ASSISTED COMPOSITE CONVERGENCE:
               step_graph_convergence already recorded graph_decision, graph_signals_json, graph_blockers_json, and graph_convergence_score for this run.
               The existing inline 3-signal vote still computes the inline STOP candidate and is not replaced.
               signals = []
               Filter: exclude iterations where status == thought from signal inputs (use only evidence iterations)
               a) Rolling average (w=0.30, needs 3+ iterations):
                  avg = mean(last 3 newInfoRatios)
                  stop if avg < convergence_threshold
               b) MAD noise floor (w=0.35, needs 4+ iterations):
                  noiseFloor = MAD(all ratios) * 1.4826
                  stop if latest ratio <= noiseFloor
               c) Question entropy (w=0.35):
                  coverage = answered / total questions
                  stop if coverage >= 0.85
               Redistribute weights for unavailable signals.
               if weighted_stop_score > 0.60: inline_stop_candidate = true
               Combined stop rule: STOP only if the inline 3-signal vote says STOP AND graph_decision is STOP_ALLOWED or absent.
               if inline_stop_candidate and graph_decision == "STOP_BLOCKED":
                 decision = "BLOCKED"
                 reason = "blockedStop"
                 stop_blocked = true
                 blocked_by_json = JSON array derived from graph_blockers_json
                 blocked_by_csv = comma-separated blocker names derived from graph_blockers_json
                 gate_convergence_pass = false
                 gate_convergence_score = graph_convergence_score
                 gate_key_question_coverage_pass = no blocker named questionCoverage
                 gate_evidence_density_pass = no blocker named sourceDiversity or evidenceDepth
                 gate_evidence_density_sources = graph_signals_json.sourceDiversity or 0
                 gate_hotspot_saturation_pass = true
                 recovery_strategy = first blocker reason/message, else "Collect deeper graph evidence before stopping."
               else if inline_stop_candidate and (graph_decision == "STOP_ALLOWED" or graph_decision is absent):
                 decision = "STOP"
                 reason = "composite_converged"
                 stop_blocked = false
          6. else: CONTINUE
          7. if decision == "STOP" and reason != "maxIterationsReached" and effective_min_iterations > 1 and iteration_count < effective_min_iterations:
               decision = "CONTINUE"
               reason = "minIterationsNotReached"
               min_iterations_guard_blocked = true
               min_iterations_guard_pass = false
          8. if effective_min_iterations > 1 and iteration_count >= effective_min_iterations and min_iterations_guard_already_passed == false:
               min_iterations_guard_pass = true
          9. if decision == "STOP" and reason != "maxIterationsReached":
               guardResult = checkQualityGuards(state, strategy)
               if not guardResult.passed:
                 log: "Quality guard failed: {guardResult.violations}. Overriding STOP to CONTINUE."
                 decision = "CONTINUE"
          See convergence.md for full pseudocode and signal definitions.
          Segment-aware convergence is experimental/reference-only; live workflow uses the current session as a single segment.
        outputs:
          - decision: "STOP | BLOCKED | STUCK_RECOVERY | CONTINUE"
          - reason: "Human-readable stop reason"
          - stop_blocked: "Boolean marker set when graph convergence vetoes an inline STOP candidate"
          - blocked_by_json: "JSON array of graph blocker names when decision == BLOCKED"
          - blocked_by_csv: "Comma-separated graph blocker names when decision == BLOCKED"
          - gate_convergence_pass: "Boolean pass/fail for the graph-assisted convergence gate"
          - gate_convergence_score: "Numeric score recorded from graph convergence"
          - gate_key_question_coverage_pass: "Boolean pass/fail derived from graph blocker coverage signals"
          - gate_evidence_density_pass: "Boolean pass/fail derived from graph blocker evidence-depth signals"
          - gate_evidence_density_sources: "Source-diversity count or equivalent evidence-depth proxy"
          - gate_hotspot_saturation_pass: "Research placeholder gate; true unless an explicit blocker sets otherwise"
          - recovery_strategy: "One-line hint describing the next research action when decision == BLOCKED or STUCK_RECOVERY"
          - min_iterations_guard_pass: "Boolean true when the configured convergence floor has cleared for the first time"
          - min_iterations_guard_blocked: "Boolean true when the configured convergence floor overrides a STOP candidate to CONTINUE"

      step_emit_min_iterations_guard_pass:
        action: "Persist a first-class event when the convergence floor clears"
        if_pass:
          bookkeeping_log: '{"type":"event","event":"min_iterations_guard_pass","mode":"research","run":{current_iteration},"iterationCount":{iteration_count},"minIterations":{effective_min_iterations},"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "Minimum iteration floor cleared for convergence stopping."

      step_emit_blocked_stop:
        action: "Persist a first-class blocked_stop event when the legal-stop decision tree returns blocked"
        if_blocked:
          append_to_jsonl: '{"type":"event","event":"blocked_stop","mode":"research","run":{current_iteration},"blockedBy":{blocked_by_json},"gateResults":{"convergence":{"pass":{gate_convergence_pass},"score":{gate_convergence_score}},"keyQuestionCoverage":{"pass":{gate_key_question_coverage_pass},"answered":{answered_count},"total":{total_questions}},"evidenceDensity":{"pass":{gate_evidence_density_pass},"sources":{gate_evidence_density_sources}},"hotspotSaturation":{"pass":{gate_hotspot_saturation_pass}}},"recoveryStrategy":"{recovery_strategy}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "Graph convergence blocked STOP. Failed blockers: {blocked_by_csv}. Recovery strategy: {recovery_strategy}"
          set:
            decision: "CONTINUE"
            reason: "blockedStop"
            stop_blocked: false

      step_handle_convergence:
        action: "Act on convergence decision"
        if_stop:
          branch_on: "convergence_mode == 'divergent' AND reason is in ['composite_converged', 'all_questions_answered']"
          if_divergent_eligible:
            eligibility_contract:
              required_decision: "STOP"
              eligible_reasons: [composite_converged, all_questions_answered]
              excluded_reasons: [maxIterationsReached, blockedStop, stuckRecovery, minIterationsNotReached, error, manualStop, userPaused]
              fail_closed: "Any missing or ambiguous reason uses if_existing_terminal_path without preparing a pivot."
            steps:
              step_prepare_divergent_pivot:
                action: "Generate state-grounded research candidates and prepare or resume the pivot transaction"
                command: |
                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
                  import {
                    buildResearchPivotPreparationInput,
                    renderResearchPivotSeatPrompt,
                  } from './.skilled/skills/system-deep-loop/deep-research/scripts/divergent-research-pivot.ts';
                  import {
                    preparePivotTransaction,
                  } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';

                  const input = buildResearchPivotPreparationInput({
                    artifactRoot: '{state_paths.packet_dir}',
                    configPath: '{state_paths.config}',
                    stateLogPath: '{state_paths.state_log}',
                    strategyPath: '{state_paths.strategy}',
                    registryPath: '{state_paths.registry}',
                    currentIteration: Number('{current_iteration}'),
                    maxIterations: Number('{max_iterations}'),
                    triggerReason: '{reason}',
                  });
                  const prepared = await preparePivotTransaction(input);
                  const seatPrompts = prepared.status === 'pending'
                    ? Object.fromEntries(prepared.missingSeats.map((seat) => [
                        seat.id,
                        renderResearchPivotSeatPrompt(seat, prepared.dispatchContext),
                      ]))
                    : {};
                  process.stdout.write(`${JSON.stringify({
                    ...prepared,
                    seatPrompts,
                    boundaryRejections: input.boundaryRejections,
                  })}\n`);
                  EOF
                working_directory: "{repo_root}"
                outputs:
                  - pivot_prepare_json: "The complete parsed JSON result"
                  - pivot_prepare_status: "status from the prepare result"
                  - pivot_id: "pivotId from the prepare result"
                  - pivot_paths_json: "paths from the prepare result as JSON"
                  - pivot_resumed: "resumed from the prepare result"
                  - pivot_missing_seat_ids: "missingSeats ids from a pending result"
                  - pivot_seat_001_json: "The seat-001 mandate object from missingSeats"
                  - pivot_seat_002_json: "The seat-002 mandate object from missingSeats"
                  - pivot_seat_003_json: "The seat-003 mandate object from missingSeats"
                  - pivot_seat_001_prompt: "seatPrompts['seat-001']"
                  - pivot_seat_002_prompt: "seatPrompts['seat-002']"
                  - pivot_seat_003_prompt: "seatPrompts['seat-003']"
                  - pivot_dispatch_context_json: "dispatchContext from a pending result as JSON"
                short_circuit: "When status is completed or failed, skip all dispatch and record steps and bind this result as pivot_result."

              step_dispatch_pivot_seat_001:
                action: "Natively dispatch the analytical research direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-research
                    model: opus
                    context_source: "pivot_seat_001_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_001."
                outputs:
                  - pivot_seat_001_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_001_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_001_error_json: "{name,message} when rejected"
                  - pivot_seat_001_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_001_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_001_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_001:
                action: "Durably record the seat-001 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-001'"
                command: |
                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_001_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_001_output_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_001_error_json}, startedAtIso: '{pivot_seat_001_started_at_iso}', completedAtIso: '{pivot_seat_001_completed_at_iso}', durationMs: Number('{pivot_seat_001_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_001_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_dispatch_pivot_seat_002:
                action: "Natively dispatch the critical research direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-research
                    model: opus
                    context_source: "pivot_seat_002_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_002."
                outputs:
                  - pivot_seat_002_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_002_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_002_error_json: "{name,message} when rejected"
                  - pivot_seat_002_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_002_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_002_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_002:
                action: "Durably record the seat-002 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-002'"
                command: |
                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_002_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_002_output_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_002_error_json}, startedAtIso: '{pivot_seat_002_started_at_iso}', completedAtIso: '{pivot_seat_002_completed_at_iso}', durationMs: Number('{pivot_seat_002_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_002_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_dispatch_pivot_seat_003:
                action: "Natively dispatch the pragmatic research direction-selection seat"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'"
                capture_timing: true
                if_native:
                  dispatch:
                    agent: deep-research
                    model: opus
                    context_source: "pivot_seat_003_prompt"
                  wait_for_completion: true
                failure_contract: "A native dispatch failure binds status=rejected, a {name,message} error, and the measured timestamps/duration, then proceeds to step_record_pivot_seat_003."
                outputs:
                  - pivot_seat_003_dispatch_status: "fulfilled or rejected"
                  - pivot_seat_003_output_json: "Raw native return serialized as JSON when fulfilled"
                  - pivot_seat_003_error_json: "{name,message} when rejected"
                  - pivot_seat_003_started_at_iso: "Dispatch start timestamp"
                  - pivot_seat_003_completed_at_iso: "Dispatch completion timestamp"
                  - pivot_seat_003_duration_ms: "Dispatch duration in milliseconds"

              step_record_pivot_seat_003:
                action: "Durably record the seat-003 native dispatch outcome"
                skip_when: "pivot_prepare_status != 'pending' or pivot_missing_seat_ids does not contain 'seat-003'"
                command: |
                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
                  import { recordPivotSeatResult } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  const status = '{pivot_seat_003_dispatch_status}';
                  const outcome = status === 'fulfilled'
                    ? { status, output: {pivot_seat_003_output_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') }
                    : { status: 'rejected', error: {pivot_seat_003_error_json}, startedAtIso: '{pivot_seat_003_started_at_iso}', completedAtIso: '{pivot_seat_003_completed_at_iso}', durationMs: Number('{pivot_seat_003_duration_ms}') };
                  process.stdout.write(`${JSON.stringify(recordPivotSeatResult({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', seat: {pivot_seat_003_json}, outcome }))}\n`);
                  EOF
                working_directory: "{repo_root}"

              step_finalize_divergent_pivot:
                action: "Finalize the prepared pivot after all missing native seats are durable"
                skip_when: "pivot_prepare_status != 'pending'"
                command: |
                  node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
                  import { finalizePivotTransaction } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/divergent-pivot.ts';
                  process.stdout.write(`${JSON.stringify(finalizePivotTransaction({ paths: {pivot_paths_json}, pivotId: '{pivot_id}', resumed: {pivot_resumed} }))}\n`);
                  EOF
                working_directory: "{repo_root}"
                outputs:
                  - pivot_finalize_json: "The complete parsed final result"

              step_resolve_divergent_pivot_result:
                action: "Use prepare's terminal result on resume/short-circuit, otherwise use finalize's result"
                branch_on: "pivot_prepare_status"
                if_pending: { bind: { pivot_result: "{pivot_finalize_json}" } }
                if_completed_or_failed: { bind: { pivot_result: "{pivot_prepare_json}" } }

              step_apply_divergent_pivot_result:
                action: "Adopt a successful focus or fail closed to the existing synthesis path"
                branch_on: "pivot_result.status"
                if_completed:
                  set:
                    next_focus: "{pivot_result.restoredFocus}"
                    pivot_lineage: "Pivot {pivot_result.pivotId} selected {pivot_result.selectedCandidate.id} from source iteration {current_iteration}."
                    saturated_directions: "{pivot_result.completedEvent.saturatedDirections}"
                  command: "node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}"
                  log: "Divergent pivot {pivot_result.pivotId} restored focus to {pivot_result.restoredFocus}; continuing iteration {current_iteration}."
                  proceed_to: step_rejected_pattern_cache
                if_failed:
                  log: "Divergent pivot {pivot_result.pivotId} failed closed ({pivot_result.failureReason}); proceeding to synthesis."
                  skip_to: phase_synthesis
            on_error:
              log: "Divergent pivot integration error; failing closed to the existing synthesis path."
              skip_to: phase_synthesis
          if_existing_terminal_path:
            log: "Loop stopping. Reason: {reason}"
            skip_to: phase_synthesis
        if_stuck_recovery:
          bookkeeping_log: '{"type":"event","event":"stuckRecovery","mode":"research","run":{current_iteration},"stopReason":"stuckRecovery","fromIteration":{current_iteration},"outcome":"recovered","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
          log: "Stuck detected ({stuck_count} consecutive no-progress). Entering recovery."
          set: { next_focus: "RECOVERY: Widen scope. Try fundamentally different approach. Least-explored question: {least_explored}" }
          reset: { stuck_count: 0 }
        if_continue:
          log: "Iteration {current_iteration}: Continuing. Focus: {next_focus}"

      step_rejected_pattern_cache:
        action: "Apply reducer-derived rejected-pattern suppression before dispatch candidate selection"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        candidate_sources:
          next_focus:
            category: "next-focus"
            values:
              - "{next_focus}"
              - "{remaining_questions_list}"
              - "{carried_forward_open_questions}"
          recovery:
            category: "recovery"
            values:
              - "{recovery_strategy}"
              - "{least_explored}"
          ideas:
            category: "ideas"
            values:
              - "{promoted_ideas_list}"
            optional_file: "{state_paths.packet_dir}/research-ideas.md"
        algorithm: |
          Use registry.rejectedPatternIndex and registry.promotedIdeas from the latest
          reducer pass as the source of truth.
          Compare normalized exact text first. Then compare fuzzy similarity with
          rejected_pattern_fuzzy_threshold, but only when candidate and rejected categories
          are compatible. Remove suppressed candidates from next_focus, recovery, and ideas
          selection before rendering the dispatch prompt. If all candidates are suppressed,
          halt for operator input instead of reusing a rejected idea.
        outputs:
          - accepted_next_focus: "First unsuppressed next-focus candidate, or null"
          - accepted_recovery_candidate: "First unsuppressed recovery candidate, or null"
          - accepted_idea_candidate: "First unsuppressed ideas candidate, or null"
          - rejected_candidate_matches: "Suppressed candidate diagnostics from registry.suppressedCandidates plus any current-step matches"
        if_next_focus_suppressed:
          set: { next_focus: "{accepted_next_focus || accepted_recovery_candidate || accepted_idea_candidate}" }
          log: "Rejected-pattern cache suppressed the prior candidate; dispatching the next accepted candidate."
        if_all_candidates_suppressed:
          halt: true
          message: "All next-focus, recovery, and ideas candidates match active rejected patterns. Remove/reset the rejected pattern or provide a new focus."

      step_ideas_backlog_lifecycle:
        action: "Track reducer-owned observed/promoted/rejected idea lifecycle before dispatch"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.config}"
        lifecycle:
          observed_event: "idea_observed"
          promoted_event: "idea_promoted"
          rejected_event: "idea_rejected"
          min_observations: "{min_idea_observations}"
          authority: "Leaf agents emit observations only; reducer emits promotions and owns ranking."
        validate:
          - "If new leaf-authored output includes idea_promoted, fail validation; only reducer output may append idea_promoted."
          - "If promoted_ideas_count > 0 and next_focus is empty or all questions are resolved, prefer the first unsuppressed promoted idea."
          - "If suppressed_ideas_count > 0, do not render those ideas into dispatch context."
        outputs:
          - observed_ideas_count: "Reducer-derived observed ideas count"
          - promoted_ideas_count: "Reducer-derived promoted ideas count after minIdeaObservations"
          - suppressed_ideas_count: "Reducer-derived rejected/suppressed ideas count"
          - accepted_idea_candidate: "First unsuppressed promoted idea, or null"

      step_normalize_pause_events:
        action: "Normalize pause and recovery lifecycle events to the frozen STOP_REASONS enum at emission time"
        stop_reasons_enum: [converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused]
        rule_pause_sentinel:
          raw_event_forbidden: '{"type":"event","event":"paused"}'
          canonical_event: '{"type":"event","event":"userPaused","mode":"research","run":{current_iteration},"stopReason":"userPaused","sentinelPath":"{state_paths.pause_sentinel}","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'
        rule_stuck_recovery:
          raw_event_forbidden: '{"type":"event","event":"stuck_recovery"}'
          canonical_event: '{"type":"event","event":"stuckRecovery","mode":"research","run":{current_iteration},"stopReason":"stuckRecovery","fromIteration":{current_iteration},"outcome":"recovered","timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'

      step_marker_scan:
        action: "H-2 loop-prevention guard: scan previous iteration's rendered prompt for nested research marker"
        canonical_header: "DEEP-RESEARCH"
        nested_marker_pattern: "^(DEEP-REVIEW|CODE-REVIEW)$"
        algorithm: |
          if current_iteration > 1:
            PREV_PROMPT_PATH = "{state_paths.prompt_dir}/iteration-{previous_iteration}.md"
            if file_exists(PREV_PROMPT_PATH):
              PREV_PROMPT_FIRST_LINE = head -1 of PREV_PROMPT_PATH
              if PREV_PROMPT_FIRST_LINE matches nested_marker_pattern:
                log "ERROR: nested research-of-review loop detected (review marker found in previous iteration prompt). Aborting."
                halt with exit code 2
        note: |
          False-positive prevention: a research prompt that starts with its own canonical
          header is this loop's own iteration output, never a nested dispatch; only a review
          marker is, so the guard matches nested_marker_pattern rather than the canonical
          header. Markers appearing in comments or body text are ignored. True-positive
          triggers only when a previous iteration's rendered prompt literally starts with a
          review marker, indicating a nested research-of-review dispatch.

      step_dispatch_iteration:
        action: "Dispatch one iteration via the selected executor"
        resolve_executor:
          source: "config.executor"
          loader: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts#parseExecutorConfig"
        pre_dispatch:
          generate_summary: |
            STATE SUMMARY (auto-generated):
            Segment: {current_segment} | Iteration: {current_iteration} of {max_iterations}
            Questions: {answered_count}/{total_questions} answered | Last focus: {last_focus}
            Last 2 ratios: {ratio_prev} -> {ratio_latest} | Stuck count: {stuck_count}
            {resource_map_prompt_line}
            {lineage_context_prompt_line}
            Next focus: {next_focus}
          render_prompt_pack:
            template_path: ".skilled/skills/system-deep-loop/deep-research/assets/prompt-pack-iteration.md.tmpl"
            renderer: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/prompt-pack.ts#renderPromptPack"
            output_path: "{state_paths.prompt_dir}/iteration-{current_iteration}.md"
            variables:
              state_summary: "{state_summary}"
              research_topic: "{research_topic}"
              current_iteration: "{current_iteration}"
              max_iterations: "{max_iterations}"
              next_focus: "{next_focus}"
              remaining_questions_list: "{remaining_questions_list}"
              carried_forward_open_questions: "{carried_forward_open_questions}"
              last_3_summaries: "{last_3_summaries}"
              pivot_lineage: "{pivot_lineage}"
              saturated_directions: "{saturated_directions}"
              state_paths_config: "{state_paths.config}"
              state_paths_state_log: "{state_paths.state_log}"
              state_paths_strategy: "{state_paths.strategy}"
              state_paths_registry: "{state_paths.registry}"
              state_paths_iteration_pattern: "{state_paths.iteration_pattern}"
              state_paths_delta_pattern: "{state_paths.delta_pattern}"
        pre_dispatch_audit:
          skip_when: "config.executor.type == 'native'"
          call: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts#writeFirstRecordExecutor"
          args:
            stateLogPath: "{state_paths.state_log}"
            executor: "{config.executor}"
            iteration: "{current_iteration}"
        branch_on: "config.executor.type"
        if_native:
          dispatch:
            agent: deep-research
            model: opus
            context_source: "rendered_prompt_pack"
          wait_for_completion: true
        if_cli_claude_code:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createHash } from 'node:crypto';

            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';

            const executor = {
              kind: 'cli-claude-code',
              model: '{config.executor.model}',
              reasoningEffort: '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}',
              serviceTier: '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}',
              sandboxMode: '{config.executor.sandboxMode}' === 'null' ? null : '{config.executor.sandboxMode}',
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
            };
            const args = [
              '-p',
              readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8'),
              '--model',
              executor.model,
              '--permission-mode',
              resolveClaudePermissionMode(executor.sandboxMode),
              '--output-format',
              'text',
            ];
            if (executor.reasoningEffort) {
              args.push('--effort', executor.reasoningEffort);
            }

            const dispatchFacts = {
              command: 'deep/research',
              mode: 'research',
              specFolder: '{spec_folder}',
              artifactDir: '{state_paths.packet_dir}',
              iteration: Number('{current_iteration}'),
              executorKind: '{config.executor.type}',
              branchId: '{config.executor.type}',
              sessionId: '{config.lineage.sessionId}',
              generation: Number('{config.lineage.generation}'),
            };
            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            process.exit(
              runAuditedExecutorCommand({
                command: 'claude',
                args,
                cwd: '{repo_root}',
                timeoutSeconds: executor.timeoutSeconds,
                stateLogPath: '{state_paths.state_log}',
                executor,
                iteration: Number('{current_iteration}'),
                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
                dispatchId,
              }),
            );
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "sandboxMode maps to permission-mode: read-only -> plan, workspace-write -> acceptEdits, danger-full-access -> bypassPermissions"
            - "claude-code has no serviceTier flag"
            - "claude-code supports --effort for reasoning depth"
        if_cli_cursor:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.type}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'research-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment advisory: detected ' + containment.violations.length
                  + ' out-of-scope path(s), left on disk: '
                  + containment.violations.map((v) => v.path).join(', '),
              );
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-cursor single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-cursor model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when cursor-agent is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-cursor executor never degrades to native"
        if_cli_devin:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.type}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'research-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment advisory: detected ' + containment.violations.length
                  + ' out-of-scope path(s), left on disk: '
                  + containment.violations.map((v) => v.path).join(', '),
              );
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-devin single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-devin model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when devin is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-devin executor never degrades to native"
        if_cli_pi:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createRequire } from 'node:module';
            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import { resolveSandboxMode, resolveClaudePermissionMode } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // cursor-agent/devin/pi have no single-executor branch of their own, so
            // without this they silently degrade to native. The command builder is the
            // same one the fan-out lineage path uses, so the enforced model allowlist,
            // headless write-mode flags, and binary preflight stay one source of truth.
            // It throws (fail closed) when the binary is absent or the model is off the
            // allowlist, so a requested CLI executor never becomes native.
            const require = createRequire(import.meta.url);
            const { buildLineageCommand } = require('./.skilled/skills/system-deep-loop/runtime/scripts/fanout-run.cjs');

            const kind = '{config.executor.type}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const timeoutSeconds = Number('{config.executor.timeoutSeconds}');
            // The iteration must write its own iteration file, delta and state record,
            // so the leaf runs workspace-write; the builder maps that to each CLI's real
            // write-permitting headless flags.
            const sandboxMode = 'workspace-write';
            const lineage = { kind, model, sandboxMode };
            const resolvedSandbox = resolveSandboxMode(sandboxMode);
            const resolvedPermission = resolveClaudePermissionMode(sandboxMode);

            const repoRoot = '{repo_root}';
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const { command, args, input } = buildLineageCommand(
              lineage,
              promptBody,
              resolvedSandbox,
              resolvedPermission,
              { env: process.env, cwd: repoRoot },
            );

            const executor = {
              kind,
              model,
              configDir: null,
              reasoningEffort: null,
              serviceTier: null,
              sandboxMode,
              timeoutSeconds,
              governor: null,
            };
            const dispatchId = 'research-i{current_iteration}-g{generation}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command,
              args,
              cwd: repoRoot,
              timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment advisory: detected ' + containment.violations.length
                  + ' out-of-scope path(s), left on disk: '
                  + containment.violations.map((v) => v.path).join(', '),
              );
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "cli-pi single-executor: dispatches per-iteration through the shared fan-out command builder (buildLineageCommand) so the enforced cli-pi model allowlist + headless write flags stay one source of truth; runAuditedExecutorCommand emits INTENT + COMPLETION receipts"
            - "Fails closed when pi is absent or the model is off the allowlist (buildLineageCommand throws, exit non-zero) — a requested cli-pi executor never degrades to native"
            - "cli-hermes single-executor: the same shared builder emits `hermes chat -Q --oneshot --query-file -` with the prompt on stdin, the two-id llmgateway roster and the max reasoning pin; fails closed when hermes is absent or the model is off the roster"
        record_executor_audit:
          skip_when: "config.executor.type == 'native'"
          target: "{state_paths.state_log}"
          field: "executor"
          value:
            kind: "{config.executor.type}"
            model: "{config.executor.model}"
            reasoningEffort: "{config.executor.reasoningEffort}"
            serviceTier: "{config.executor.serviceTier}"
        if_cli_opencode:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { createHash } from 'node:crypto';

            import { runAuditedExecutorCommand } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';

            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const executor = {
              kind: 'cli-opencode',
              model: '{config.executor.model}',
              configDir: null,
              reasoningEffort,
              serviceTier: null,
              sandboxMode: null,
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };
            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');
            const message = 'Resolved route: mode=research; target_agent=@deep-research; execution=single_iteration; state_source=externalized_files; do_not_switch_mode=true'
              + '\n\n'
              + promptBody;
            const args = [
              'run',
              '--model',
              executor.model,
              '--format',
              'json',
              '--dangerously-skip-permissions',
              '--pure',
              '--dir',
              '{repo_root}',
            ];
            if (executor.reasoningEffort) {
              args.push('--variant', executor.reasoningEffort);
            }
            args.push(message);

            const dispatchFacts = {
              command: 'deep/research',
              mode: 'research',
              specFolder: '{spec_folder}',
              artifactDir: '{state_paths.packet_dir}',
              iteration: Number('{current_iteration}'),
              executorKind: '{config.executor.type}',
              branchId: '{config.executor.type}',
              sessionId: '{config.lineage.sessionId}',
              generation: Number('{config.lineage.generation}'),
            };
            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            process.exit(
              runAuditedExecutorCommand({
                command: 'opencode',
                args,
                cwd: '{repo_root}',
                timeoutSeconds: executor.timeoutSeconds,
                stateLogPath: '{state_paths.state_log}',
                executor,
                iteration: Number('{current_iteration}'),
                // opencode v1.14.39 reads stdin at startup before session creation;
                // an empty input gives EOF stdin, equivalent to </dev/null.
                input: '',
                receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
                dispatchId,
              }),
            );
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "Routed through runAuditedExecutorCommand so opencode produces INTENT + COMPLETION dispatch receipts; recursion guard + env allowlist enforced via buildExecutorDispatchEnv"
            - "input:'' yields closed stdin (EOF), equivalent to </dev/null — opencode v1.14.39 reads stdin at startup and hangs at 0% CPU after +60s snapshot prune without it (the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §4 ALWAYS rule)"
            - "opencode run takes a positional message; prompt is the route-proof preamble + iteration body"
            - "--variant maps reasoningEffort to opencode's provider-specific reasoning lever (e.g., high, medium, minimal)"
            - "--dangerously-skip-permissions enables hands-off automation; sandboxMode='read-only' is not currently honored (no opencode equivalent)"
            - "cli-opencode self-invocation guard: this branch must only run from a non-OpenCode dispatch surface (Claude Code/raw shell). the `cli-external-orchestration/cli-opencode` mode's SKILL.md (`.skilled/skills/cli-external-orchestration/cli-opencode/SKILL.md`) §SELF-INVOCATION PROHIBITED contract is the authoritative gate"
        if_cli_codex:
          command: |
            node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
            import { readFileSync } from 'node:fs';
            import { execFileSync } from 'node:child_process';

            import {
              RECURSION_GUARD_EXIT_CODE,
              formatRecursionGuardRefusal,
              runAuditedExecutorCommand,
              validateExecutorDispatchAllowed,
            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-audit.ts';
            import {
              snapshotOutOfScopeDirtyPaths,
              enforceWriteContainment,
            } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/write-containment.ts';

            // Fail closed: a requested codex executor must dispatch codex or abort,
            // never silently degrade to another executor. Undetected absence is what
            // got Codex deprecated before, so the branch exits non-zero when the
            // binary is missing instead of falling through to a native/other path.
            let codexAvailable = false;
            try {
              execFileSync('/bin/sh', ['-c', 'command -v codex >/dev/null 2>&1'], { stdio: 'ignore' });
              codexAvailable = true;
            } catch {}
            if (!codexAvailable) {
              console.error('cli-codex executor unavailable: command -v codex failed');
              process.exit(1);
            }

            const reasoningEffort = '{config.executor.reasoningEffort}' === 'null' ? null : '{config.executor.reasoningEffort}';
            const serviceTier = '{config.executor.serviceTier}' === 'null' ? null : '{config.executor.serviceTier}';
            const model = '{config.executor.model}' === 'null' ? null : '{config.executor.model}';
            const executor = {
              kind: 'cli-codex',
              model,
              configDir: null,
              reasoningEffort,
              serviceTier,
              sandboxMode: 'workspace-write',
              timeoutSeconds: Number('{config.executor.timeoutSeconds}'),
              governor: null,
            };

            // Refuse before any spawn and before any receipt is written, so a refusal can
            // never be mistaken for a real attempt. A process that is already a CLI lineage
            // or a codex session must run the iteration itself, not delegate it onward.
            const guardVerdict = validateExecutorDispatchAllowed(executor, { env: process.env });
            if (!guardVerdict.allowed) {
              console.error(formatRecursionGuardRefusal(guardVerdict, executor));
              process.exit(RECURSION_GUARD_EXIT_CODE);
            }

            const promptBody = readFileSync('{state_paths.prompt_dir}/iteration-{current_iteration}.md', 'utf8');

            // codex reads the iteration prompt from stdin via the trailing '-'. A research
            // iteration must WRITE its own iteration file, delta and state record, so the
            // sandbox is workspace-write — read-only would block those required writes.
            // approval_policy=never keeps the run non-interactive.
            const args = ['exec'];
            if (model) {
              args.push('--model', model);
            }
            args.push('-c', 'model_reasoning_effort=' + (reasoningEffort || 'medium'));
            if (serviceTier) {
              args.push('-c', 'service_tier=' + serviceTier);
            }
            args.push('-c', 'approval_policy=never', '--sandbox', executor.sandboxMode, '-');

            const dispatchId = 'research-i{current_iteration}-g{config.lineage.generation}';
            const repoRoot = '{repo_root}';
            const artifactDir = '{artifact_dir}';
            const preDispatchDirtyPaths = snapshotOutOfScopeDirtyPaths({ repoRoot, artifactDir });
            const dispatchExit = runAuditedExecutorCommand({
              command: 'codex',
              args,
              cwd: repoRoot,
              timeoutSeconds: executor.timeoutSeconds,
              stateLogPath: '{state_paths.state_log}',
              executor,
              iteration: Number('{current_iteration}'),
              input: promptBody,
              receiptDir: '{state_paths.packet_dir}/dispatch-receipts',
              dispatchId,
            });
            // Structural write-containment: the artifact-dir boundary is prompt-only, so a
            // workspace-write leaf can write anywhere in the repo. The guard diffs the tree
            // after the dispatch and reports every NEW out-of-artifact-dir path. Its remedy
            // PRESERVES by default -- event recorded, copy quarantined, bytes left on disk --
            // because a path it cannot attribute may belong to a concurrent writer, so a
            // revert here would destroy work this lane never wrote; reverting is opt-in per
            // run and is not implied by this call. Remedy authority, both modes:
            // runtime/lib/deep-loop/write-containment.ts. A violation is reported below and
            // left on disk, never made fatal here: what the run does about it is the
            // verdict's to decide. The leaf's own writes under artifactDir (iteration
            // file/delta/state record) are never flagged.
            const containment = enforceWriteContainment({
              repoRoot,
              artifactDir,
              preDispatchDirtyPaths,
              stateLogPath: '{state_paths.state_log}',
              iteration: Number('{current_iteration}'),
              label: dispatchId,
            });
            if (containment.violations.length > 0) {
              console.error(
                'write-containment advisory: detected ' + containment.violations.length
                  + ' out-of-scope path(s), left on disk: '
                  + containment.violations.map((v) => v.path).join(', '),
              );
            }
            process.exit(dispatchExit);
            EOF
          working_directory: "{repo_root}"
          timeout_seconds: "{config.executor.timeoutSeconds}"
          wait_for_completion: true
          notes:
            - "PRE-DISPATCH RULE (read before running the script): when this run is ITSELF a fan-out CLI lineage — config.fanout_lineage_artifact_dir is bound, or SPECKIT_FANOUT_LINEAGE_ID / SPECKIT_CLI_DISPATCH_STACK / CODEX_SESSION_ID is present in the environment — the lineage IS the executor. Do NOT run this dispatch script. Perform the iteration in-process instead: read the rendered prompt at {state_paths.prompt_dir}/iteration-{current_iteration}.md, do the research yourself, and write the iteration file, the delta and the state record exactly as the leaf contract requires, then continue to post_dispatch_validate."
            - "Nested CLI dispatch from a lineage is a route violation, not a slow path: a codex lineage that runs this script spawns codex inside its own sandbox, where the child cannot initialize and every iteration fails. The script refuses that case before any spawn and before any dispatch receipt is written, exiting RECURSION_GUARD_EXIT_CODE; that refusal is a route error to fix, never a redispatchable executor failure."
            - "Routed through runAuditedExecutorCommand so codex produces INTENT + COMPLETION dispatch receipts; recursion guard (CODEX_SESSION_ID) + env allowlist (CODEX_/OPENAI_/AZURE_OPENAI_) enforced via buildExecutorDispatchEnv"
            - "Fails closed when the codex binary is absent (exit 1) — parity with the fan-out cli-codex lineage guard in fanout-run.cjs; codex routing never degrades to native"
            - "codex exec reads the iteration prompt from stdin via the trailing '-' (input: promptBody); '-c model_reasoning_effort=' maps reasoning depth, default medium; '-c service_tier=' forwarded when configured"
            - "--sandbox workspace-write is required so the iteration can write its own iteration file/delta/state record (read-only would fail the post-dispatch artifact gate); -c approval_policy=never keeps it non-interactive; --model omitted when unset so ~/.codex/config.toml default applies"
        post_dispatch_validate:
          validator: ".skilled/skills/system-deep-loop/runtime/lib/deep-loop/post-dispatch-validate.ts#validateIterationOutputs"
          command: "node .skilled/skills/system-deep-loop/runtime/scripts/verify-iteration.cjs --loop-type research --artifact-dir {artifact_dir} --iteration {current_iteration}"
          command_note: "Mechanical leaf-reliability gate: exit 0 = complete; non-zero prints one machine reason (iteration_file_missing|state_record_missing|route_proof_missing|route_proof_mismatch|delta_file_missing). The script enforces the artifact + route-proof contract instead of trusting the leaf to self-report, and a non-zero exit triggers on_failure.redispatch_once."
          assert_exists: "{state_paths.iteration_pattern}"
          assert_appended: "{state_paths.state_log}"
          assert_jsonl_fields: [type, iteration, newInfoRatio, status, focus, mode]
          route_proof:
            mode: research
            target_agent: deep-research
            agent_definition_loaded: true
            resolved_route: "Resolved route: mode=research target_agent=deep-research"
          dispatchReceipt:
            receiptDir: "{state_paths.packet_dir}/dispatch-receipts"
            dispatchId: "research-i{current_iteration}-g{config.lineage.generation}"
          optional_jsonl_fields:
            logOffset: "Byte offset where the seekable log region starts"
            logSize: "Byte length of the seekable log region"
            logPath: "Absolute path to the file containing the seekable log region"
            skippedCount: "Missed fixed-rate slots counted for the completed dispatch; 0 when no slot was missed"
            slotDurationMs: "Monotonic elapsed duration for the completed dispatch slot"
          assert_canonical_type: "iteration"
          assert_delta_file_exists: "{state_paths.delta_pattern}"
          assert_delta_file_has_iteration_record: true
          on_failure:
            action: "emit schema_mismatch canonical conflict event"
            redispatch_once: "On the FIRST failure of the mechanical command check for this iteration, re-run step_dispatch_iteration exactly once for the same iteration number, then re-run the check. If it still fails, record the iteration as error and continue. Never re-dispatch a given iteration more than once."
            escalation: "After 3 consecutive failures across iterations, trigger stuck_recovery event with diagnostic context"
          failure_reasons_reference:
            - "iteration_file_missing — iteration narrative markdown not written"
            - "iteration_file_empty — iteration narrative markdown is zero bytes"
            - "jsonl_not_appended — state log file did not grow since pre-dispatch snapshot"
            - "jsonl_missing_fields — last state-log record omits required schema fields"
            - "jsonl_parse_error — last state-log line is not valid JSON"
            - "jsonl_wrong_type — last state-log record uses type!='iteration' (e.g. 'iteration_delta'); reducer will silently drop"
            - "delta_file_missing — per-iteration deltas/iter-NNN.jsonl not written"
            - "delta_file_empty — per-iteration delta file exists but has zero bytes"
            - "delta_file_missing_iteration_record — delta file lacks any record with type='iteration'"
            - "route_proof_missing — state-log or delta iteration record omits route-proof fields"
            - "route_proof_mismatch — state-log or delta iteration record does not match the resolved deep route"
            - "executor_missing — non-native executor did not record provenance"
            - "dispatch_failure_logged — last record is an explicit dispatch_failure event"

      step_run_now_restore_check:
        action: "Record a run-now sentinel recreated during the completed dispatch"
        command: |
          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
          EVENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deep-research-run-now.XXXXXX")"
          node - "$EVENT_DIR" <<'EOF'
          const { existsSync, readFileSync, writeFileSync } = require('node:fs');
          const { join } = require('node:path');

          const eventDir = process.argv[2];
          const stateLogPath = "{state_paths.state_log}";
          const sentinelPath = "{state_paths.run_now_sentinel}";
          const sessionId = "{config.lineage.sessionId}";
          const generation = Number("{config.lineage.generation}");
          const run = Number("{current_iteration}");

          function hasAcceptedCurrentRun() {
            if (!existsSync(stateLogPath)) return false;
            const lines = readFileSync(stateLogPath, "utf8").trim().split(/\r?\n/).filter(Boolean);
            for (let index = lines.length - 1; index >= 0; index -= 1) {
              const record = JSON.parse(lines[index]);
              if (record.run !== run || record.sessionId !== sessionId) continue;
              if (record.event === "run_now_accepted") return true;
              if (record.event === "run_now_rejected") return false;
            }
            return false;
          }

          if (existsSync(sentinelPath) && hasAcceptedCurrentRun()) {
            // The restored-sentinel row is staged for the gateway: the projection is
            // rebuilt from the ledger, so appending beside it loses the row.
            writeFileSync(
              join(eventDir, "01-run_now_restored.json"),
              JSON.stringify({
                stem: "deep_research.run_now_restored",
                scope: { runId: sessionId, lineageId: sessionId },
                data: { mode: "research", run, sessionId, generation, sentinelPath },
              }),
              "utf8",
            );
          }
          EOF
          for eventFile in "$EVENT_DIR"/*.json; do
            [ -e "$eventFile" ] || continue
            node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$eventFile"
            GATEWAY_STATUS=$?
            if [ "$GATEWAY_STATUS" -ne 0 ]; then
              rm -rf "$EVENT_DIR"
              exit "$GATEWAY_STATUS"
            fi
          done
          rm -rf "$EVENT_DIR"
        outputs:
          - run_now_restored: "Emitted when an operator recreates the sentinel before the accepted dispatch completes"

      step_reduce_state:
        action: "Run the reducer to synchronize registry, dashboard, and strategy"
        command: "node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder}"
        inputs:
          latestJSONLDelta: "Latest JSONL records written since the previous iteration"
          newIterationFile: "{state_paths.iteration_pattern}"
          priorReducedState: "{state_paths.registry}"
        outputs:
          - "{state_paths.registry}"
          - "{state_paths.dashboard}"
          - "{state_paths.strategy}"
          - "{state_paths.state_log} question_conflict events when inbox text disagrees with registry-owned question text"
          - "{state_paths.state_log} idempotent idea_promoted events when observed ideas reach minIdeaObservations"
          - "{state_paths.registry} observedIdeas, promotedIdeas, suppressedIdeas, rejectedPatterns, and suppressedCandidates from idea lifecycle events"
        failure_modes:
          malformed_delta: "skip + warn"
          missing_iteration_file: "no-op + error"
          schema_mismatch: "reject + conflict event"
          question_conflict: "keep registry value + append question_conflict event with inboxValue, registryValue, and operatorDecision"
        guarantee: "Idempotent for identical inputs"

      step_graph_upsert:
        action: "Persist the latest iteration graph delta after the reducer refresh and after the iteration file exists"
        note: "Skips with an informational line and exit 0 when this iteration carries no graph events."
        command: |
          node <<'EOF'
          const { existsSync, readFileSync } = require('node:fs');
          const { join } = require('node:path');
          const { spawnSync } = require('node:child_process');

          const deltaDir = '{state_paths.delta_dir}';
          const stateLogPath = '{state_paths.state_log}';
          const iteration = Number('{current_iteration}');
          const specFolder = '{spec_folder}';
          const sessionId = '{config.lineage.sessionId}';

          function parseJsonLines(raw, source) {
            const records = [];
            for (const line of raw.split(/\r?\n/)) {
              const trimmed = line.trim();
              if (!trimmed) continue;
              try {
                records.push(JSON.parse(trimmed));
              } catch (error) {
                process.stderr.write(`deep-research graph upsert: skipped malformed line in ${source}: ${error.message}\n`);
              }
            }
            return records;
          }

          function latestGraphEvents(records) {
            for (let index = records.length - 1; index >= 0; index -= 1) {
              const record = records[index];
              if (record && record.type === 'iteration') {
                return Array.isArray(record.graphEvents) ? record.graphEvents : [];
              }
            }
            return [];
          }

          const deltaPath = join(deltaDir, `iter-${String(iteration).padStart(3, '0')}.jsonl`);
          const sourcePath = existsSync(deltaPath) ? deltaPath : stateLogPath;
          const records = existsSync(sourcePath) ? parseJsonLines(readFileSync(sourcePath, 'utf8'), sourcePath) : [];
          const events = latestGraphEvents(records);

          const nodes = [];
          const edges = [];
          for (const event of events) {
            if (!event || typeof event !== 'object') continue;
            if (event.type === 'node') {
              nodes.push({ ...event, name: event.label ?? event.name ?? event.id });
            } else if (event.type === 'edge') {
              edges.push({
                ...event,
                sourceId: event.sourceId ?? event.source,
                targetId: event.targetId ?? event.target,
                relation: String(event.relation ?? '').toUpperCase(),
              });
            }
          }

          if (nodes.length === 0 && edges.length === 0) {
            process.stdout.write(`deep-research graph upsert: no graph events for iteration ${iteration}; skipping\n`);
            process.exit(0);
          }

          const upsert = spawnSync(
            process.execPath,
            [
              '.skilled/skills/system-deep-loop/runtime/scripts/upsert.cjs',
              '--spec-folder', specFolder,
              '--loop-type', 'research',
              '--session-id', sessionId,
              '--nodes', JSON.stringify(nodes),
              '--edges', JSON.stringify(edges),
            ],
            { encoding: 'utf8' },
          );
          if (upsert.error) {
            process.stderr.write(`deep-research graph upsert: failed to spawn upsert.cjs: ${upsert.error.message}\n`);
          }
          if (upsert.stdout) process.stdout.write(upsert.stdout);
          if (upsert.stderr) process.stderr.write(upsert.stderr);
          process.exit(upsert.status === null ? 1 : upsert.status);
          EOF

      step_refresh_lineage_context:
        action: "Refresh the focused context line from lineage-local state before the next prompt render"
        read:
          - "{state_paths.dashboard}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        source_note: "step_reduce_state has just rewritten all three, so the freshest view of this lineage is already on disk. No index, daemon or network call is involved."
        use_response:
          - "Update lineage_context_prompt_line with a concise summary for the next step_dispatch_iteration.pre_dispatch.generate_summary."
        failure_policy:
          missing_state_file: "non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line"
          unreadable_state_file: "non-fatal; log advisory warning and continue with the previous lineage_context_prompt_line"
        outputs:
          - lineage_context_prompt_line: "Fresh focused context summary for the next iteration prompt"
          - lineage_context_refresh_status: "refreshed | advisory_error"

      step_evaluate_results:
        action: "Verify iteration outputs and extract metrics"
        verify:
          - file_exists: "{state_paths.iteration_pattern}"
          - jsonl_appended: "New iteration record in state.jsonl"
          - strategy_updated: "Reducer refreshed strategy machine-owned sections"
          - registry_updated: "Reducer refreshed findings-registry.json"
        extract:
          - newInfoRatio: "From latest JSONL iteration record"
          - findings_count: "From latest JSONL iteration record"
          - status: "From latest JSONL iteration record"
          - latest_focus: "From latest JSONL iteration record"
        on_missing_outputs:
          action: "Mark iteration as 'error', continue to next"
          # Canonical iteration record: include mode, sessionId, generation, durationMs, keyQuestions, answeredQuestions
          # so the reducer can persist the failure without dropping the iteration. Schema source: state-format.md §Iteration Records.
          append_jsonl: '{"type":"iteration","iteration":{current_iteration},"run":{current_iteration},"mode":"research","status":"error","focus":"{next_focus}","findingsCount":0,"newInfoRatio":0.0,"keyQuestions":[],"answeredQuestions":[],"durationMs":0,"timestamp":"{ISO_8601_NOW}","sessionId":"{config.lineage.sessionId}","generation":{config.lineage.generation}}'

      step_telemetry_heartbeat_progress:
        action: "Emit a single-loop progress row when iteration state changes"
        skip_when: "config.fanout is present"
        command: |
          node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
          import { existsSync, readFileSync } from 'node:fs';

          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';
          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';

          const { appendObservabilityEvent } = observabilityEvents;
          const stateLogPath = '{state_paths.state_log}';
          const timestamp = '{ISO_8601_NOW}';
          const sessionId = '{config.lineage.sessionId}';
          const generation = Number('{config.lineage.generation}');
          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';

          function readRecords(path) {
            if (!existsSync(path)) return [];
            return readFileSync(path, 'utf8')
              .split(/\r?\n/)
              .map((line) => line.trim())
              .filter(Boolean)
              .map((line) => JSON.parse(line));
          }

          function elapsedSince(value) {
            const startedAtMs = Date.parse(String(value ?? ''));
            const nowMs = Date.parse(timestamp);
            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;
            return Math.max(0, nowMs - startedAtMs);
          }

          const records = readRecords(stateLogPath);
          const iterations = records.filter((record) => record.type === 'iteration');
          const latest = iterations.at(-1) ?? {};
          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt
            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp
            ?? timestamp;
          const elapsedMs = elapsedSince(startedAt);
          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;
          const run = Number.isFinite(Number(latest.run)) ? Number(latest.run) : Number('{current_iteration}');
          const status = typeof latest.status === 'string' ? latest.status : 'unknown';
          const row = {
            event: 'progress',
            label: 'single',
            at: timestamp,
            duration_ms: elapsedMs,
            loop_type: 'research',
            sessionId,
            generation,
            run,
            status,
            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },
          };

          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {
            diffData: { event: row.event, label: row.label, sessionId, generation, run, status, gauges: { iterations: iterations.length, score } },
            diffField: 'state_hash',
          });
          if (appended) {
            try {
              appendObservabilityEvent(observabilityPath, row, {
                producer: 'deep-research-auto',
                stream: 'single-loop-telemetry',
                subject: { label: row.label, sessionId, generation, run },
                event: row.event,
                status,
              });
            } catch {}
          }
          EOF
        working_directory: "{repo_root}"
        outputs:
          - status_ledger_progress: "A fan-out-shaped status row with label single and event progress"

      step_generate_dashboard:
        action: "Generate or refresh the human-readable dashboard"
        read:
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        template: .skilled/skills/system-deep-loop/deep-research/assets/deep-research-dashboard.md
        output: "{state_paths.dashboard}"
        note: "Auto-generated from JSONL + reducer registry + strategy. Never manually edited."

      step_update_tracking:
        action: "Update loop tracking variables"
        set:
          current_iteration: "{current_iteration + 1}"
          stuck_count: "if status == 'thought': unchanged (skip). if status == 'insight': 0 (reset). if newInfoRatio < convergence_threshold: stuck_count + 1, else: 0"
        log: "Iteration {N} complete. newInfoRatio: {newInfoRatio}. Findings: {findings_count}. Stuck count: {stuck_count}."

      step_loop_decision:
        action: "Return to step_read_state for next iteration"
        goto: step_read_state

  # ═══════════════════════════════════════════════════════════════
  # PHASE 3: SYNTHESIS
  # ═══════════════════════════════════════════════════════════════
  phase_synthesis:
    purpose: Compile all iteration findings into final research/research.md
    steps:

      step_fanout_merge:
        description: "Merge N lineage registries into one consolidated registry; skip when single-executor"
        skip_when: "config.fanout is absent"
        command: |
          node .skilled/skills/system-deep-loop/runtime/scripts/fanout-merge.cjs \
            --loop-type research \
            --artifact-dir {artifact_dir}
        working_directory: "{repo_root}"
        wait_for_completion: true

      step_hydrate_summary_metrics:
        action: "Hydrate summary metrics before synthesis"
        read:
          - "{state_paths.config}"
          - "{state_paths.state_log}"
          - "{state_paths.registry}"
          - "{state_paths.strategy}"
        read_patterns:
          - "{state_paths.packet_dir}/lineages/*/deep-research-state.jsonl"
          - "{state_paths.packet_dir}/lineages/*/deep-research-strategy.md"
        extract:
          - iteration_count: "When direct lineage state logs exist, count type === 'iteration' across those logs in stable lineage order; otherwise count the root state log. Never add root compatibility records to lineage records."
          - current_iteration: "iteration_count + 1"
          - current_segment: "Latest segment_start event segment, else 1"
          - last_focus: "Extract focus from latest iteration record, else 'none yet'"
          - ratio_prev: "Extract newInfoRatio from second-latest iteration record, else 'N/A'"
          - ratio_latest: "Extract newInfoRatio from latest iteration record, else 'N/A'"
          - remaining_questions: "Count unchecked items in 'Key Questions'"
          - remaining_questions_list: "List unchecked key questions from strategy.md"
          - answered_count: "Count answered questions from strategy.md"
          - total_questions: "Count total questions tracked in strategy.md"
          - last_3_summaries: "Summarize the latest 3 iteration records as 'run N: focus (ratio)'"
          - divergence_summary: "Read registry.divergence and summarize saturated directions, completed pivots, failures, overrides, Council artifact refs, and remaining frontier; else 'no divergent pivots recorded'"
          - reason: "Use the latest synthesis/recovery stop reason if present, else the frozen default 'converged'. (Must be a member of the STOP_REASONS enum: converged, maxIterationsReached, blockedStop, stuckRecovery, error, manualStop, userPaused.)"

      step_read_all_iterations:
        action: "Read all iteration files and strategy"
        read_patterns:
          - "{state_paths.iteration_dir}/iteration-*.md"
          - "{state_paths.packet_dir}/lineages/*/iterations/iteration-*.md"
        read_also: "{state_paths.strategy}"
        identity: "Preserve each full source path and lineage label. Duplicate basenames from different lineages are distinct synthesis inputs; do not copy or renumber them."
        selection: "When lineage iteration files exist, synthesize from those files in stable lineage-plus-iteration order; otherwise use root iterations."

      step_emit_resource_map:
        action: "Emit {state_paths.resource_map_output} from converged research deltas unless config.resource_map.emit is false"
        branch_on: "config.fanout"
        if_present:
          command: "node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map --fanout-resource-map-only"
          read:
            - "{state_paths.config}"
            - "{state_paths.delta_dir}/iter-*.jsonl"
            - "{state_paths.packet_dir}/lineages/*/deltas/iter-*.jsonl"
        if_absent:
          command: "node .skilled/skills/system-deep-loop/deep-research/scripts/reduce-state.cjs {spec_folder} --emit-resource-map"
          read:
            - "{state_paths.config}"
            - "{state_paths.delta_dir}/iter-*.jsonl"
        write:
          - "{state_paths.resource_map_output}"
        guarantee: "Fan-out resource-map emission reads lineage deltas in place and writes only resource-map.md; it never rewrites merged registries, strategy, or dashboard. Single-executor reduction remains unchanged."

      step_compile_research:
        action: "Compile or finalize research/research.md"
        instructions: |
          If research/research.md exists (progressive synthesis was active):
            1. Read current research/research.md
            2. Consolidate and deduplicate findings across all iterations
            3. Fill any empty sections with findings from iteration files
            4. Remove redundancy while preserving all unique findings
            5. Add convergence report as appendix
            6. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation
            7. Preserve the mandatory `## Eliminated Alternatives` section, then add or replace `## Divergence Map` immediately after it and before Section 12 Open Questions. Populate it from `{state_paths.registry}` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier.

          If research/research.md does not exist:
            1. Create research/research.md following 17-section template
            2. Populate sections from iteration files
            3. Add citations from original sources
            4. Note unanswered questions in Open Questions section
            5. If `resource_map_present` is true, cite `{spec_folder}/resource-map.md` in References; otherwise omit any placeholder map citation
            6. After the mandatory `## Eliminated Alternatives` section and before Section 12 Open Questions, add `## Divergence Map` with saturated directions, pivots taken, evidence and Council artifact references, pivot failures and audited overrides, and the remaining frontier from `{state_paths.registry}`.
          Divergence Map documents breadth. Never claim the topic converged merely because divergent mode broadened the investigated frontier.
          Preserve machine-owned markers so the reducer-owned registry, dashboard, and strategy anchors can be refreshed on re-run without mutating prior synthesis. (Note: `completed-continue` lineage branch is deferred — see `deep-research/references/protocol/loop-protocol.md §Lifecycle Branch Contract`.)
        output: "{state_paths.research_output}"

      step_convergence_report:
        action: "Generate and append convergence report"
        report: |
          ## Convergence Report
          - Stop reason: {reason}
          - Total iterations: {iteration_count}
          - Questions answered: {answered_count} / {total_questions}
          - Remaining questions: {remaining_questions}
          - Last 3 iteration summaries: {last_3_summaries}
          - Convergence threshold: {convergence_threshold}
          - Divergence summary: {divergence_summary}
          - Segment transitions, wave scores, and checkpoint metrics are experimental and omitted from the live report.
        command: |
          GATEWAY=".skilled/skills/system-deep-loop/runtime/scripts/append-mode-event.cjs"
          [ -f "$GATEWAY" ] || GATEWAY="scripts/append-mode-event.cjs"
          EVENT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deep-research-synthesis.XXXXXX")"
          CLOSEOUT=".skilled/skills/system-deep-loop/runtime/scripts/synthesis-closeout.cjs"
          [ -f "$CLOSEOUT" ] || CLOSEOUT="scripts/synthesis-closeout.cjs"
          node "$CLOSEOUT" --mode research --event-dir "$EVENT_DIR" \
            --artifact-dir "{state_paths.packet_dir}" \
            --state-log "{state_paths.state_log}" \
            --registry "{state_paths.registry}" \
            --output "{state_paths.research_output}" \
            --dashboard "{state_paths.dashboard}" \
            --stop-reason "{reason}" \
            --answered-count "{answered_count}" --total-questions "{total_questions}"
          NODE_STATUS=$?
          for eventFile in "$EVENT_DIR"/*.json; do
            [ -e "$eventFile" ] || continue
            node "$GATEWAY" --mode research --run-directory "$(dirname "{state_paths.state_log}")" --event-json "$eventFile"
            GATEWAY_STATUS=$?
            if [ "$GATEWAY_STATUS" -ne 0 ]; then
              rm -rf "$EVENT_DIR"
              exit "$GATEWAY_STATUS"
            fi
          done
          rm -rf "$EVENT_DIR"
          exit "$NODE_STATUS"

      step_writeback_spec_findings:
        action: "Write or replace the bounded generated findings block in spec.md before config completion"
        edit: "{spec_folder}/spec.md"
        host_anchor: "Use the chosen host anchor required by spec_check_protocol"
        generated_fence_begin: "<!-- BEGIN GENERATED: deep-research/spec-findings -->"
        generated_fence_end: "<!-- END GENERATED: deep-research/spec-findings -->"
        fail_closed_conflict_check:
          if_existing_generated_fence_present:
            detect_manual_edits: "Use generated checksum metadata or an explicit MANUAL-EDIT marker inside the existing fence to detect human edits before overwrite."
            on_manual_edit_conflict:
              append_to_jsonl: '{"type":"spec_mutation","event":"spec_mutation_conflict","folder_state":"conflict-detected","reason":"Manual edits detected inside existing generated findings fence.","specPath":"{spec_folder}/spec.md","generatedFence":"deep-research/spec-findings","conflictKind":"generated-fence-manual-edit","timestamp":"{ISO_8601_NOW}"}'
              halt: true
        instructions:
          - "Read `{state_paths.research_output}` as the canonical synthesis source."
          - "Replace exactly one generated findings block under the chosen host anchor."
          - "Fail closed if the host anchor is missing, duplicate markers exist, or human edits are detected inside the generated block."
          - "Do not overwrite a generated block that fails checksum validation or carries an explicit MANUAL-EDIT marker."
          - "Emit `spec_synthesis_deferred` instead of partial output when synthesis cannot safely write back."
        append_to_jsonl: '{"type":"spec_mutation","event":"spec_mutation","phase":"post-synthesis","anchors_touched":["<chosen host anchor>"],"diff_summary":"Replaced generated deep-research findings fence from research/research.md.","generatedFence":"deep-research/spec-findings","timestamp":"{ISO_8601_NOW}"}'

      step_validate_post_synthesis_spec_doc:
        action: "Run targeted strict validation after deep-research writes back into spec.md"
        command: "SPECKIT_RULES=FRONTMATTER_VALID,LEVEL_DECLARED,TEMPLATE_SOURCE,PLACEHOLDER_FILLED,ANCHORS_VALID,SPEC_DOC_INTEGRITY,TOC_POLICY bash .skilled/skills/system-spec-kit/runtime/cli/spec/validate.sh {spec_folder} --strict"
        note: "Fail closed before completion if the deep-research spec.md sync breaks the authored-spec structural contract. This targeted check uses the fast Node validation orchestrator."

      step_update_config_status:
        action: "Mark config as complete"
        edit: "{state_paths.config}"
        set_field: { status: "complete" }

      step_telemetry_heartbeat_terminal:
        action: "Emit a single-loop terminal row in the orchestration status ledger"
        skip_when: "config.fanout is present"
        terminal_events: [completed, failed, stopped]
        command: |
          node --import "$(node -p "require.resolve('tsx', { paths: ['.skilled/skills/system-deep-loop/runtime'] })")" --input-type=module <<'EOF'
          import { existsSync, readFileSync } from 'node:fs';

          import { appendJsonlIfChangedAtomic } from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/atomic-state.ts';
          import observabilityEvents from './.skilled/skills/system-deep-loop/runtime/lib/deep-loop/observability-events.cjs';

          const { appendObservabilityEvent } = observabilityEvents;
          const stateLogPath = '{state_paths.state_log}';
          const config = JSON.parse(readFileSync('{state_paths.config}', 'utf8'));
          const timestamp = '{ISO_8601_NOW}';
          const sessionId = String(config.lineage?.sessionId ?? '{config.lineage.sessionId}');
          const generation = Number(config.lineage?.generation ?? '{config.lineage.generation}');
          const reason = '{reason}';
          const observabilityPath = '{state_paths.packet_dir}/observability-events.jsonl';

          function readRecords(path) {
            if (!existsSync(path)) return [];
            return readFileSync(path, 'utf8')
              .split(/\r?\n/)
              .map((line) => line.trim())
              .filter(Boolean)
              .map((line) => JSON.parse(line));
          }

          function elapsedSince(value) {
            const startedAtMs = Date.parse(String(value ?? ''));
            const nowMs = Date.parse(timestamp);
            if (!Number.isFinite(startedAtMs) || !Number.isFinite(nowMs)) return 0;
            return Math.max(0, nowMs - startedAtMs);
          }

          function terminalEvent(stopReason) {
            if (stopReason === 'manualStop' || stopReason === 'userPaused') return 'stopped';
            if (stopReason === 'error') return 'failed';
            return 'completed';
          }

          const records = readRecords(stateLogPath);
          const iterations = records.filter((record) => record.type === 'iteration');
          const latest = iterations.at(-1) ?? {};
          const startedAt = records.find((record) => typeof record.createdAt === 'string')?.createdAt
            ?? records.find((record) => typeof record.timestamp === 'string')?.timestamp
            ?? timestamp;
          const elapsedMs = elapsedSince(startedAt);
          const score = Number.isFinite(Number(latest.newInfoRatio)) ? Number(latest.newInfoRatio) : 0;
          const event = terminalEvent(reason);
          const row = {
            event,
            label: 'single',
            terminal: true,
            reason,
            at: timestamp,
            duration_ms: elapsedMs,
            loop_type: 'research',
            sessionId,
            generation,
            gauges: { iterations: iterations.length, elapsed_ms: elapsedMs, score },
          };

          const appended = appendJsonlIfChangedAtomic('{state_paths.status_ledger}', row, {
            diffData: { event, label: row.label, reason, sessionId, generation, gauges: { iterations: iterations.length, score } },
            diffField: 'state_hash',
          });
          if (appended) {
            try {
              appendObservabilityEvent(observabilityPath, row, {
                producer: 'deep-research-auto',
                stream: 'single-loop-telemetry',
                subject: { label: row.label, sessionId, generation, reason },
                event,
                status: event,
              });
            } catch {}
          }
          EOF
        working_directory: "{repo_root}"
        outputs:
          - status_ledger_terminal: "A fan-out-shaped status row with label single and event completed, failed, or stopped"

      step_stage_artifact_dir:
        action: "Stage all skill-owned artifacts under artifact_dir for the operator's next git commit"
        command: 'git add -- "{state_paths.packet_dir}" ":(exclude){state_paths.packet_dir}/.deep-research.lock" ":(exclude){state_paths.packet_dir}/.deep-research-pause" ":(exclude){state_paths.packet_dir}/.deep-research-run-now" ":(exclude){state_paths.packet_dir}/.legacy-projection-watermarks"'
        note: "Skill-owned contract fix (028): without this stage step, operators who do `git add research-report.md` lose the iteration trail (iterations/, deltas/, state.jsonl, strategy, etc.). Staging the whole artifact_dir keeps the audit trail intact. Operators retain commit authority and can `git restore --staged {path}` to unstage anything before commit. Failure is non-fatal: log warning and continue. The exclude pathspecs keep the live lock file, the pause and run-now sentinels, and the legacy projection watermark directory out of the index; locks-and-fencing-v1, ledgers, deltas, iterations and the state log stay staged."
        on_fail: "Log warning. Do not block synthesis. The artifact_dir may be outside a git repo (e.g., temp test fixture) which is a valid case."

  # ═══════════════════════════════════════════════════════════════
  # PHASE 4: SAVE
  # ═══════════════════════════════════════════════════════════════
  phase_save:
    purpose: Preserve research context in the packet's canonical continuity documents
    steps:

      step_compose_save_payload:
        action: "Compose the structured JSON payload consumed by generate-context.js"
        output: "/tmp/save-context-data-<session-id>.json"
        requirements:
          - "Write this file before invoking generate-context.js; the loader fails closed if the explicit JSON file is absent."
          - "Include `specFolder`, a concise `sessionSummary`, curated `observations`, `recent_context`, `toolCalls`, and `exchanges` from the completed research loop."
          - "Use a session-scoped temp filename; do not use the retired shared `/tmp/save-context-data.json` path."
        example_payload: |
          {
            "specFolder": "{spec_folder}",
            "sessionSummary": "Deep research completed; see research/research.md for synthesized findings.",
            "observations": ["Summarize the final research conclusions and evidence."],
            "recent_context": ["Point to the generated research artifacts and next action."],
            "exchanges": [],
            "toolCalls": []
          }

      step_generate_context:
        action: "Route continuity content into the correct canonical spec document via generate-context.js"
        command: "node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js /tmp/save-context-data-<session-id>.json {spec_folder}"
        critical_rule: "NEVER manually author files under retired memory/ paths (the runtime rejects them); use generate-context.js so the save routes into decision-record.md, implementation-summary.md, or handover.md"

      step_verify_save:
        action: "Verify canonical save routed content into the correct spec document"
        check: "Does {spec_folder}/implementation-summary.md, {spec_folder}/decision-record.md, or {spec_folder}/handover.md carry the new continuity update?"
        on_fail: "Log warning but do not block completion"

      step_release_lock:
        action: "Release the single-writer lock after save, skip-save, or cancellation cleanup has resolved"
        command: "node .skilled/skills/system-deep-loop/runtime/scripts/loop-lock.cjs release --lock-path {state_paths.lock_file} --owner-pid {captured_owner_pid} --nonce {captured_acquire_nonce}"
        bookkeeping_log: '{"type":"event","event":"lock_released","path":"{state_paths.lock_file}","releasePhase":"save","timestamp":"{ISO_8601_NOW}"}'

  # ═══════════════════════════════════════════════════════════════
  # COMPLETION
  # ═══════════════════════════════════════════════════════════════
  completion:
    message: |
      Deep research complete.
      Iterations: {iteration_count} | Stop reason: {reason}
      Questions answered: {answered_count}/{total_questions}

      Artifacts:
        - research/research.md (compiled from {iteration_count} iterations)
        - {iteration_count} iteration files in research/
        - State files: config.json, state.jsonl, strategy.md, findings-registry.json, dashboard.md
        - Continuity update routed into the canonical spec document

      STATUS=OK PATH={spec_folder}
    next_steps:
      - "/speckit:plan [feature-description]"
      - "/deep:research [new-topic] (for related deep research)"
      - "/speckit:save {spec_folder} (refresh canonical continuity before the next session)"

# ─────────────────────────────────────────────────────────────────
# ERROR RECOVERY
# ─────────────────────────────────────────────────────────────────
error_recovery:
  agent_dispatch_timeout: "Retry once with reduced scope (fewer research actions). If second timeout, mark as 'timeout' and continue."
  state_file_missing: "If JSONL missing during loop, reconstruct from iteration files. If strategy missing, create minimal version."
  consecutive_failures: "After 3 consecutive errors, halt loop and enter synthesis with partial findings."
  continuity_save_failure: "Preserve the research/ packet as backup. Log warning."

# ─────────────────────────────────────────────────────────────────
# RULES
# ─────────────────────────────────────────────────────────────────
rules:
  ALWAYS:
    - follow_workflow_phases_in_order
    - dispatch_deep_research_agent_per_iteration
    - check_convergence_before_each_iteration
    - write_all_state_to_files
    - refresh_lineage_context_before_next_prompt
    - write_continuity_after_synthesis
    - respect_max_iterations_cap
  NEVER:
    - skip_convergence_check
    - dispatch_non_leaf_agents
    - hold_iteration_findings_in_memory_only
    - modify_config_after_initialization
    - overwrite_jsonl_state_log
    - proceed_without_state_file_verification

# ─────────────────────────────────────────────────────────────────
# REFERENCE-ONLY APPENDIX
# ─────────────────────────────────────────────────────────────────
reference_only_appendix:
  checkpoint_commit:
    note: "Checkpoint commits are intentionally excluded from workflow.steps."
    commands:
      - "git add {state_paths.iteration_pattern} {state_paths.state_log} {state_paths.strategy} {state_paths.research_output}"
      - 'git commit -m "chore(deep-research): iteration {NNN} complete" -m "{one-line summary of what the iteration found}"'
  wave_orchestration:
    note: "Wave execution is intentionally excluded from workflow.steps."
    summary:
      - "Check whether 3+ independent unanswered questions justify a wave."
      - "Dispatch up to 3 parallel agents on distinct questions."
      - "Score wave results by median newInfoRatio and promote top branches."

--- LOOP PROTOCOL ---
---
title: Loop Protocol Reference
description: Canonical specification for the deep research loop lifecycle with 4 phases, reference-only wave orchestration, and error handling.
trigger_phrases:
  - "research loop protocol"
  - "research loop lifecycle"
  - "research loop initialization"
  - "research auto resume protocol"
  - "research pause sentinel"
  - "research synthesis phase"
importance_tier: important
contextType: implementation
version: 1.14.0.29
---

# Loop Protocol Reference

Canonical specification for the deep research loop lifecycle. Use it as the lifecycle map for initialization, iteration, synthesis, save, and recovery.

---

## 1. OVERVIEW

### Purpose

Define the lifecycle contract for deep-research initialization, iteration, synthesis, save, reference-only dispatch concepts, and error handling.

### When to Use

Load this reference when running or validating the research loop lifecycle. Use `../convergence/convergence.md` for STOP decisions and `../state/state-format.md` for packet file schemas.

### Core Principle

The YAML workflow owns lifecycle orchestration, `@deep-research` executes LEAF iterations, and the reducer synchronizes packet state after each iteration and lifecycle transition.

### Phase Model

The deep research loop has 4 phases: initialization, iteration (repeated), synthesis, and save.

Runtime capability matrix references for parity-sensitive loop behavior:
- Human-readable matrix: `.skilled/skills/system-deep-loop/deep-research/references/guides/capability-matrix.md`
- Machine-readable matrix: `.skilled/skills/system-deep-loop/deep-research/assets/runtime-capabilities.json`

```text
┌──────────┐     ┌──────────────────────────┐     ┌───────────────────────┐     ┌──────────┐
│  INIT    │────>│  LOOP                    │────>│  SYNTHESIS            │────>│  SAVE    │
│          │     │  ┌────────────────────┐  │     │                       │     │          │
│ Config    │     │  │ Read State         │  │     │ Final                 │     │ Memory   │
│ Strategy │     │  │ Check Convergence  │  │     │ research/research.md  │     │ Context  │
│ State    │     │  │ Dispatch Agent     │  │     │ compilation           │     │ Save     │
│          │     │  │ Evaluate Results   │  │     │                       │     │          │
│          │     │  │ Loop Decision      │  │     │                       │     │          │
│          │     │  └────────┬───────────┘  │     │                       │     │          │
│          │     │           │ repeat       │     │                       │     │          │
└──────────┘     └──────────────────────────┘     └───────────────────────┘     └──────────┘
```

---

## 2. PHASE: INITIALIZATION

### Purpose
Set up all state files for a new research session.

### Steps

1. **Classify session state before writing**:
   - `fresh`: no config/state/strategy files exist
   - `resume`: config + state + strategy all exist and agree
   - `completed-session`: consistent prior state with `config.status == "complete"`
   - `invalid-state`: partial or contradictory artifacts
2. **Resolve canonical artifact names**:
   - Read legacy aliases during the migration window if needed
   - Write only canonical `deep-research-*` names
   - Emit a `migration` event for every legacy alias consumed
3. **Resolve local artifact owner**: `artifact_dir = resolveArtifactRoot(specFolder, 'research').artifactDir`, then `mkdir -p {artifact_dir}/iterations`
4. **Write config**: `research/deep-research-config.json` from template + user parameters
5. **Initialize state log**: Append the config record as the first line of `research/deep-research-state.jsonl` through the append gateway, the only way a record reaches the log
6. **Initialize strategy**: `research/deep-research-strategy.md` from template with:
   - Topic from user input
   - Initial key questions (3-5, from topic analysis)
   - Known context from the continuity ladder and ripgrep recipes (if any), injected only after the strategy file exists
   - Research boundaries from config
6a. **Detect resource-map integration state**:
   - Check `{spec_folder}/resource-map.md` once during init
   - If present: set `resource_map_present = true` in `deep-research-config.json`
   - Summarize the map into `deep-research-strategy.md` `Known Context`
   - The summary MUST include per-section entry counts for `READMEs`, `Documents`, `Commands`, `Agents`, `Skills`, `Specs`, `Scripts`, `Tests`, `Config`, and `Meta`
   - The summary MUST also include a one-line theme summary for each resource-map section
   - If absent: set `resource_map_present = false` and append `resource-map.md not present; skipping coverage gate` to `Known Context`
7. **Initialize findings registry**: `research/findings-registry.json` with empty `openQuestions`, `resolvedQuestions`, `keyFindings`, and `ruledOutDirections`
7a. **Validate Research Charter**:
   - Verify strategy.md contains a "Non-Goals" section (may be empty but must exist)
   - Verify strategy.md contains a "Stop Conditions" section (may be empty but must exist)
   - If either section is missing, append it as an empty placeholder before proceeding
   - In **confirm mode**: present the charter (topic, key questions, non-goals, stop conditions) for user review before proceeding
   - In **auto mode**: accept the charter automatically and continue
8. **Resume only if config, JSONL, and strategy agree**; otherwise halt for repair instead of guessing

### Outputs
- `research/deep-research-config.json`
- `research/deep-research-state.jsonl` (1 line)
- `research/deep-research-strategy.md`

### Auto-Resume Protocol
If state files already exist from a prior session:
1. Verify config, JSONL, and strategy all exist and agree on topic/spec folder
2. Read JSONL, count iteration records
3. Read strategy.md for current state
4. Set iteration counter to last completed + 1
5. Record the canonical resume event through the append gateway, the only way a record reaches `deep-research-state.jsonl` (all fields below are required by the reducer):

```json
{"type":"event","event":"resumed","mode":"research","sessionId":"rsr-2026-03-18T10-00-00Z","parentSessionId":"rsr-2026-03-18T10-00-00Z","lineageMode":"resume","continuedFromRun":4,"generation":1,"timestamp":"2026-03-18T14:05:00Z"}
```

6. Continue loop from `step_read_state`.

### Lifecycle Branch Contract (current release)

The runtime supports three lineage modes today. `fork` and `completed-continue` were described in earlier drafts but have no workflow wiring in this release, so they MUST NOT be exposed to operators. If the long-form lineage feature is picked up later it will arrive with first-class event emission, reducer ancestry handling, and replay fixtures; until then treat the contract below as canonical.

| Mode | Session id | Generation | Archive | JSONL event | When to pick |
|------|-----------|-----------|---------|-------------|--------------|
| `new` | fresh | 1 | n/a | implicit (config record) | no existing state |
| `resume` | same | same | none | `resumed` (see example above) | operator wants to continue the current lineage boundary |
| `restart` | fresh | `prior + 1` | prior `research/` tree moved under `research_archive/{timestamp}/` | `restarted` (same field set plus `archivedPath`) | operator wants to clear the workspace and replay with a new angle |

**Contract for every persisted lifecycle event**:

```json
{
  "type": "event",
  "event": "resumed | restarted",
  "mode": "research",
  "sessionId": "<session id of the new or continuing lineage>",
  "parentSessionId": "<session id of the prior lineage (equals sessionId on resume)>",
  "lineageMode": "resume | restart",
  "generation": <number>,
  "continuedFromRun": <number or null>,
  "archivedPath": "<path or null>",
  "timestamp": "<ISO 8601>"
}
```

Every field in the contract MUST be present on every persisted lifecycle event. `archivedPath` is null for `resumed` and set to the archive destination for `restarted`. `continuedFromRun` is the number of completed iteration records before the lifecycle boundary. Reducer parity tests ensure the dashboard `Lifecycle` section reads exactly those fields.

---

## 3. PHASE: ITERATION LOOP

### Loop Steps (repeated until convergence)

#### Step 1: Read State
- Read `deep-research-state.jsonl` -- count iterations, get last newInfoRatio
- Read `deep-research-strategy.md` -- get next focus, remaining questions

#### Step 2: Check Convergence
Run the convergence algorithm (see convergence.md):
- Max iterations reached? STOP
- Stuck count >= threshold? STUCK_RECOVERY
- Average newInfoRatio < threshold? STOP
- All questions answered? STOP
- Otherwise: CONTINUE

#### Step 2c: Quality Guard Check

When the convergence algorithm returns STOP:
1. Run quality guard checks (see convergence.md §2.4)
2. Verify minimum coverage, source diversity, and question resolution thresholds
3. If **all guards pass**: proceed with STOP, exit to synthesis
4. If **any guard fails**: override decision to CONTINUE
   - Log each violation: `{"type":"event","event":"guard_violation","guard":"<name>","iteration":N,"detail":"<reason>"}`
   - Persist the blocked legal-stop outcome: `{"type":"event","event":"blocked_stop","mode":"research","run":N,"blockedBy":["<gate>"],"gateResults":{"convergence":{"pass":true,"score":0.0},"keyQuestionCoverage":{"pass":false,"answered":X,"total":Y},"evidenceDensity":{"pass":false,"sources":N},"hotspotSaturation":{"pass":true}},"recoveryStrategy":"<one-line hint>","timestamp":"<ISO8601>","sessionId":"<sid>","generation":G}`
   - Append failed guard details to strategy.md "Active Risks" section
5. The loop continues until BOTH convergence AND quality guards pass simultaneously
6. Guard checks apply only to STOP decisions - CONTINUE and STUCK_RECOVERY bypass this step

If the legal-stop decision tree returns `blocked`, the workflow MUST append the `blocked_stop` JSONL event before continuing. Reducers and dashboards consume the persisted event; they must not infer blocked-stop state solely from prose logs.

#### Step 2a: Check Pause Sentinel

Before dispatching, check for a pause sentinel file:

1. Check if `research/.deep-research-pause` exists
2. If present:
   - Log event to JSONL: `{"type":"event","event":"userPaused","mode":"research","run":N,"stopReason":"userPaused","sentinelPath":"{artifact_dir}/.deep-research-pause","timestamp":"<ISO8601>","sessionId":"<sid>","generation":G}`
   - Halt the loop with message:
     ```text
     Research paused. Delete research/.deep-research-pause to resume.
     Current state: Iteration {N}, {remaining} questions remaining.
     ```
   - Do NOT exit to synthesis -- the loop is suspended, not stopped
3. On resume (file deleted and loop restarted):
   - Log event: `{"type":"event","event":"resumed","fromIteration":N}`
   - Continue from step_read_state

Pause and recovery events use the frozen stop-reason enum on the live path. Raw `paused` and `stuck_recovery` labels are legacy aliases and MUST be normalized to `userPaused` and `stuckRecovery` at emission time.

**Use case**: In autonomous mode, this provides the only graceful intervention mechanism short of killing the process. Users can create the sentinel file at any time to pause research between iterations.

#### Step 2b: Generate State Summary

Generate a compact state summary (~200 tokens) for injection into the dispatch prompt:

```text
STATE SUMMARY (auto-generated):
Segment: {current_segment} | Iteration: {N} of {max}
Questions: {answered}/{total} answered | Last focus: {last_focus}
Last 2 ratios: {ratio_N-1} -> {ratio_N} | Stuck count: {stuck_count}
Recovery: {active_recovery_strategy or "none"}
Next focus: {strategy.nextFocus}
```

This summary is prepended to the dispatch context (Step 3) to ensure the agent has baseline context even if detailed strategy.md reading fails or is incomplete. It serves as a redundant context channel.

#### Step 2d: Rejected Pattern Cache Check

Before selecting the next-focus, recovery, or ideas-backed candidate for dispatch, read the reducer-owned rejected-pattern cache and promoted ideas backlog from the findings registry.

Rejected-cache lifecycle:

1. `idea_rejected` appends one rejected pattern to JSONL with `ideaId`, `idea` or `pattern`, optional `category`, optional `reason`, and normal lifecycle fields.
2. The reducer derives the active cache from JSONL events; generated registry and dashboard files expose `rejectedPatterns`, `rejectedPatternIndex`, and `suppressedCandidates`.
3. Exact suppression compares normalized candidate text against normalized rejected text.
4. Fuzzy suppression uses `rejectedPatternFuzzyThreshold` from config when present, otherwise `0.85`, and only applies when the rejected category is compatible with the candidate category.
5. `ideaRejectedRemoved` removes a single active pattern by id or by pattern/category.
6. `ideaRejectedReset` clears all active rejected patterns for the current replay.

The active cache is capped at 100 entries. When the replay would exceed that cap, the oldest active entry is evicted and the reducer emits a warning. Operators can re-add an evicted pattern with another `idea_rejected` event if it remains relevant. Existing `ideaRejected` replay rows are legacy aliases and remain accepted for backward compatibility.

Ideas lifecycle:

1. Leaf agents may append `idea_observed` events only. They must not append `idea_promoted`.
2. The reducer accumulates observations by `ideaId` or a normalized text-derived id.
3. `minIdeaObservations` defaults to `2` and is clamped to `1..10`.
4. When an idea reaches `observationCount >= minIdeaObservations`, the reducer appends one idempotent `idea_promoted` event and ranks promoted ideas by observation count, latest observation, then first observation.
5. `idea_rejected` removes the matching idea from `promotedIdeas` and from ideas-backed next-focus candidates until a reset/removal event clears the active rejected pattern.

Candidate categories:

| Category | Candidate source |
|----------|------------------|
| `next-focus` | Strategy next-focus, carried-forward open questions, open questions, and follow-up findings |
| `recovery` | Stuck and blocked-stop recovery strategies |
| `ideas` | Reducer-promoted ideas backlog entries |
| `general` | Cross-category fallback when a narrower category is not known |

When all candidates in a category are suppressed, continue with the next eligible category or halt for operator input rather than reusing the rejected idea.

#### Step 3: Dispatch Agent
Dispatch `@deep-research` with explicit context:
```text
{state_summary}  // Auto-generated (Step 2b)

Research Topic: {config.topic}
Iteration: {N} of {maxIterations}
Focus Area: {strategy.nextFocus}
Remaining Questions: {strategy.remainingQuestions}
Last 3 Iterations Summary: {brief summaries}
Resource Map: if `config.resource_map_present == true`, prior-inventoried files are listed in `{spec_folder}/resource-map.md`; treat them as the exclusion set when hunting for net-new files; flag only missed-from-map candidates as gaps.
State Files:
  - Config: {artifact_dir}/deep-research-config.json
  - State: {artifact_dir}/deep-research-state.jsonl
  - Strategy: {artifact_dir}/deep-research-strategy.md
Output: Write findings to {artifact_dir}/iterations/iteration-{NNN}.md
CONSTRAINT: LEAF agent -- do NOT dispatch sub-agents
```

#### Executor Resolution (spec 018 + 019)

Before dispatching, the YAML resolves the executor via `parseExecutorConfig` from `.skilled/skills/system-deep-loop/runtime/lib/deep-loop/executor-config.ts`. The resolved `config.executor.kind` selects the dispatch branch:

- `native` (spec 018): dispatch `@deep-research` agent with model Opus.
- `cli-opencode` (spec 018): pipe rendered prompt via stdin to `opencode run --model X --format json --dangerously-skip-permissions --pure --dir {repo_root} [--variant Y]`. **This grants full OS-level workspace write access.** There is no `--sandbox workspace-write` flag in the live command, and `sandboxMode='read-only'` is NOT currently honored/enforced by opencode (no opencode equivalent exists). The only real containment is (a) the prompt-level "ALLOWED WRITE PATHS" / "BANNED OPERATIONS" contract rendered into the iteration prompt, which relies on the model obeying instructions rather than an OS-level sandbox, and (b) post-dispatch validation catching some violations after the fact. Fetched/reviewed content must be treated as potentially adversarial (untrusted) for prompt-injection purposes.
- `cli-claude-code` (spec 019): `claude -p "$(cat prompt)" --model X --permission-mode acceptEdits --output-format text` with optional `--effort Y`. Default permission-mode is `plan` (read-only); we override to `acceptEdits` so iteration writes succeed. The inline workflow branches are not the complete schema: `cli-codex` is also an inline branch, while `cli-cursor`, `cli-devin`, `cli-pi`, and `cli-hermes` use the shared fan-out adapters; the executor-kind authority is `runtime/lib/deep-loop/executor-config.ts` (`EXECUTOR_KINDS`).

All branches share:
1. Pre-dispatch prompt rendering via `renderPromptPack` (writes to `{artifact_dir}/prompts/iteration-{n}.md`).
2. Post-dispatch validation via `validateIterationOutputs` (asserts iteration file + JSONL delta + required fields).
3. Executor audit append via `appendExecutorAuditToLastRecord` (skipped when kind=='native').

Per-kind flag-compatibility is enforced at config parse time by `EXECUTOR_KIND_FLAG_SUPPORT` in `executor-config.ts`. Setting a flag that the chosen kind does not support throws `ExecutorConfigError` before dispatch.

Cross-CLI delegation (a running executor invoking other CLIs via its shell) is documented design intent. Runtime recursion detection is out of scope; see the SKILL.md Cross-CLI Delegation subsection.

Two containment rules bind every CLI lineage (any `cli-*` executor kind):

- **The lineage is the executor, so it works in-process.** A CLI lineage performs each iteration itself, with its own tools, inside the session the driver already started. The YAML's per-iteration executor dispatch steps are satisfied by the lineage. Spawning a second CLI process for the same iteration is a route violation, not an optimization, and on codex it also fails outright (see `cli-external-orchestration/cli-codex/SKILL.md` Rule 18).
- **Write containment attributes every new dirty path outside the lineage directory to the lineage, and reports it rather than undoing it.** Attribution on a shared checkout is a guess: a tracked file changed anywhere in the same checkout during a lineage window looks identical whether the lineage, an operator, or another session wrote it. So the default remedy is preserve. The file is left byte-for-byte as it stands, the finding is recorded on the status ledger and the observability stream, and a lane that produced its artifacts still settles as complete, carrying `completed_with_containment_advisory`. Restoring is opt-in and safe only on a checkout with a single writer; under it a path that was already dirty when the lineage started is put back to its pre-dispatch bytes, never to HEAD, and a path whose baseline could not be captured is preserved regardless. Untracked files are never deleted in either mode. One exemption still applies to attribution: another run's lineage directory under the same top-level packet is treated as that run's own write surface while its loop lock is live, so two lineages can run in sibling phases of one packet at the same time; a directory with no lock, or a stale one, is still attributed here. The runtime records each finding's diff under the lineage directory at `containment/quarantine/<iteration>[-attempt-<n>]/`, in a `containment-out-of-scope/` subdirectory on the default preserve path and `containment-reverted/` only under restore, where bytes really were rolled back; each pass keeps its own directory so a retry never overwrites an earlier pass's evidence. The pre-dispatch baseline bytes go to `<lineage dir>/containment/baseline/`, so an out-of-scope change stays recoverable either way.

Failure handling remains unchanged from spec 018: `schema_mismatch` → conflict event → 3 consecutive failures → `stuck_recovery`.

The dispatch context may include a suggested `focusTrack` label (e.g., `"focusTrack": "performance"`, `"focusTrack": "security"`). Agents may tag their iteration with this track label for post-hoc grouping and analysis. Track labels are metadata only - the orchestrator does not use them for loop decisions.

#### Step 3a: Per-Iteration Budget

After dispatch, the orchestrator monitors the running iteration against budget limits:
- **Tool call count**: tracked against `config.maxToolCallsPerIteration` (default: 12)
- **Elapsed time**: tracked against `config.maxMinutesPerIteration` (default: 10)
- If either limit is exceeded and no iteration file has been written yet:
  1. Mark the iteration as `"status": "timeout"` in the JSONL record
  2. Log event: `{"type":"event","event":"iteration_timeout","iteration":N,"reason":"tool_calls|elapsed_time"}`
  3. Continue to the next iteration (do not retry the timed-out iteration)
- Budget limits are soft caps - if the agent is actively writing its iteration file when the limit is reached, allow completion

#### Step 4: Evaluate Results
After agent completes:
1. Verify `{artifact_dir}/iterations/iteration-{NNN}.md` was created
2. Verify JSONL was appended with iteration record
3. Run reducer with `{ latestJSONLDelta, newIterationFile, priorReducedState }`
   - This is a **delta refresh**, not a full replay of every historical JSONL row on each iteration.
   - The reducer consumes only the newest JSONL slice plus the latest iteration artifact against the previously reduced packet state.
4. Verify reducer refreshed `deep-research-strategy.md`, `findings-registry.json`, and `deep-research-dashboard.md`
5. Verify the refreshed packet surfaces reflect the new iteration evidence
6. Extract `newInfoRatio` from JSONL record
7. Track stuck count: skip if `status == "thought"` (no change), reset to 0 if `status == "insight"` (breakthrough counts as progress), increment if `newInfoRatio < config.convergenceThreshold`, reset otherwise

#### Step 4a: Generate Dashboard

After evaluating iteration results, generate a human-readable dashboard:

1. Read JSONL state log, findings registry, and strategy.md
2. Generate or regenerate `research/deep-research-dashboard.md` with the following sections:
   - **Iteration table**: `| run | focus | newInfoRatio | findings count | status |`
   - **Question status**: `X/Y answered` with itemized list (answered vs remaining)
   - **Trend**: Last 3 newInfoRatio values with direction indicator (ascending, descending, flat)
   - **Dead ends**: Consolidated from all iteration `ruledOut` data
   - **Next focus**: Current value from strategy.md
   - **Active risks**: Guard violations, stuck count, budget warnings
3. Log event: `{"type":"event","event":"dashboard_generated","iteration":N}`
4. The dashboard is **auto-generated only** - never manually edited
5. The dashboard file is overwritten each iteration (not appended)
6. Dashboard generation is non-blocking: if it fails, log a warning and continue the loop

In **confirm mode**, the dashboard is displayed to the user at each iteration approval gate. In **auto mode**, it is written silently for post-hoc review.

#### Step 4b: Checkpoint Commit (REFERENCE-ONLY)

This checkpointing pattern is documented for reference, but current runtimes should not assume it is available.

After each iteration is verified (JSONL appended, iteration file written, reducer outputs refreshed):

1. **Stage targeted files only** (never `git add -A`):
   ```bash
   git add research/iterations/iteration-{NNN}.md
   git add research/deep-research-state.jsonl
   git add research/deep-research-strategy.md
   git add research/findings-registry.json
   git add research/deep-research-dashboard.md
   git add research/research.md  # if it exists
   ```
2. **Sanitize**: Exclude `.env`, credentials, large binaries from staging
3. **Commit**: `git commit -m "chore(deep-research): iteration {NNN} complete" -m "{one-line summary of what the iteration found}"`
4. **On commit failure**: Log warning and continue (checkpoint is non-blocking)

Checkpoint commits provide rollback points: `git log -- research/` shows the last good state for the research packet. If state corruption occurs, `git checkout HEAD~1 -- research/deep-research-state.jsonl` restores the previous version.

#### Step 5: Loop Decision
- If convergence check returns STOP: exit to synthesis
- If STUCK_RECOVERY: modify focus directive, reset stuck count, continue
- Otherwise: increment iteration counter, go to Step 1

### Ideas Backlog Convention

The canonical ideas backlog is reducer-owned and derived from JSONL lifecycle events. A persistent ideas file at `research/research-ideas.md` may still exist as operator-authored context, but leaf agents record new machine-discovered tangents with `idea_observed` events.

#### Check Points

The orchestrator checks the ideas backlog at three points:

1. **Init**: During strategy initialization, if `research/research-ideas.md` exists from a prior session, read it as operator-authored context and incorporate relevant ideas into the initial key questions or "Next Focus"
2. **Stuck**: During stuck recovery (Step 2a of the recovery protocol in convergence.md), check reducer-promoted ideas before defaulting to generic recovery strategies. Promoted ideas often provide the best escape from stuck states
3. **Resume**: On auto-resume, read JSONL, registry, strategy.md, and any operator-authored ideas file to restore full context

#### Event Format

```json
{"type":"event","event":"idea_observed","mode":"research","run":4,"ideaId":"idea-cache-stampede","idea":"Investigate cache stampede mitigation","category":"ideas","source":"iteration-004.md","timestamp":"2026-05-24T00:00:00Z"}
{"type":"event","event":"idea_promoted","mode":"research","run":5,"ideaId":"idea-cache-stampede","idea":"Investigate cache stampede mitigation","category":"ideas","observationCount":2,"minIdeaObservations":2,"firstObservedRun":4,"lastObservedRun":5,"timestamp":"2026-05-24T00:01:00Z"}
{"type":"event","event":"idea_rejected","mode":"research","run":6,"ideaId":"idea-cache-stampede","idea":"Investigate cache stampede mitigation","category":"ideas","reason":"Operator rejected this direction","timestamp":"2026-05-24T00:02:00Z"}
```

Users can edit `research-ideas.md` between sessions to steer future iterations. Agents do not promote ideas directly; they emit observations, and the reducer owns promotion, ranking, rejection filtering, and dashboard projection.

### Stuck Recovery Protocol
When stuckThreshold consecutive iterations show no progress (default: 3, configurable via config.json):

**Step 0: Classify Failure Mode**
Before selecting a recovery strategy, classify why progress stalled:
1. Read the last N iteration files (where N = stuckThreshold) to determine the failure pattern
2. Classify into one of the following modes:
   - `shallow_sources` - iterations find content but lack depth or authoritative sources
   - `contradictory` - iterations return conflicting information without resolution
   - `too_broad` - focus area is too wide, producing scattered low-value findings
   - `repetitive` - iterations keep rediscovering the same information
   - `exhausted` - the topic area has been thoroughly explored with diminishing returns
3. Select a targeted recovery prompt based on the classification (see convergence.md §4 for category-specific strategies)
4. Log classification: `{"type":"event","event":"stuck_classified","mode":"<classification>","iteration":N}`

**Steps 1-5: Execute Recovery**
1. Read strategy.md "What Worked" section
2. Identify least-explored question from "Key Questions"
3. Set next focus to: "RECOVERY: Widen scope to {least-explored-area}. Try a fundamentally different approach." (refined by classification)
4. Reset stuck counter
5. If recovery iteration also shows no progress: exit to synthesis with gaps documented

### Step 3b: Direct Mode Fallback (REFERENCE-ONLY)

When agent dispatch fails after the earlier recovery tiers are exhausted:

1. Detect dispatch failure: Task tool timeout, API overload (529), or agent crash
2. Log event: `{"type":"event","event":"direct_mode","iteration":N,"reason":"dispatch_failure"}`
3. Orchestrator absorbs the iteration work:
   - Read state files (JSONL + strategy.md)
   - Determine focus from strategy "Next Focus"
   - Execute 3-5 research actions directly
   - Write `research/iterations/iteration-NNN.md`
   - Update strategy.md
   - Record the iteration through the append gateway
4. Continue loop normally after direct-mode iteration completes
5. If direct mode also fails, escalate to the final user-escalation tier

**Note**: Direct mode iterations are logged with `"directMode": true` in their JSONL record for diagnostic tracking.

---

## 4. WAVE ORCHESTRATION PROTOCOL (REFERENCE-ONLY)

An optional parallel execution concept for research topics with multiple independent questions. Treat this as reference guidance only; the live workflow remains sequential and does **not** emit wave-specific JSONL events or routing today.

### When to Use Waves

- 3+ independent key questions identified during initialization
- Questions do not depend on each other's answers
- Parallelism is beneficial (time-constrained research, broad survey)

### Wave Execution Model (conceptual only)

```text
Wave 1: Dispatch N agents on independent questions
  |
  +-- Agent A: Question 1 --> iteration-001.md (newInfoRatio: 0.8)
  +-- Agent B: Question 2 --> iteration-002.md (newInfoRatio: 0.3)
  +-- Agent C: Question 3 --> iteration-003.md (newInfoRatio: 0.7)
  |
Scoring: Rank by newInfoRatio, prune below median only in a future runtime that explicitly adds wave support
  |
Wave 2: Follow-up on top-K questions (K = ceil(N/2))
  +-- Agent A: Question 1 follow-up --> iteration-004.md
  +-- Agent C: Question 3 follow-up --> iteration-005.md
  |
Repeat until convergence
```

### Scoring and Pruning

In a future wave-enabled runtime:
1. Rank all wave iterations by `newInfoRatio`
2. Compute wave median: `median([i.newInfoRatio for i in wave_iterations])`
3. **Prune**: Questions with newInfoRatio below median would be deprioritized
4. **Promote**: Top-K questions (K = ceil(N/2)) would get follow-up iterations
5. Pruned questions would move to the ideas backlog, not be discarded

### Breakthrough Detection

When any single iteration in a wave achieves `newInfoRatio > 2x wave_average`:

1. Flag as **breakthrough**: `{"type":"event","event":"breakthrough","iteration":N,"ratio":X.XX}`
2. Generate 2-3 adjacent questions from the breakthrough findings
3. Prioritize these adjacent questions in the next wave
4. Breakthrough iterations are NEVER pruned

### Wave JSONL Records

Wave-specific fields and events are **not part of the current persisted contract**. Until a runtime explicitly ships wave support, keep iteration records and events on the standard sequential schema only.

### Integration with Sequential Loop

- Waves are an ALTERNATIVE to sequential iteration, not a replacement
- The convergence algorithm applies identically (uses all iteration records)
- A future wave-capable runtime could transition back to sequential mode when questions narrow to 1-2
- The current runtime never spawns a wave automatically

---

## 5. CONTEXT ISOLATION DISPATCH (EXPERIMENTAL, REFERENCE-ONLY)

An alternative dispatch mechanism that guarantees fresh context per iteration by launching a new OS process. Treat this as reference-only unless the runtime explicitly implements alternate CLI dispatch.

### Motivation

The standard dispatch (Task tool) shares the parent session's token budget. In long research sessions (10+ iterations), this may cause context compression that degrades reasoning quality. Process-level isolation eliminates this risk.

### Dispatch Mechanism

Replace Task tool dispatch with shell-level `claude -p` invocation:

1. **Generate prompt**: Orchestrator builds a self-contained prompt from:
   - Strategy.md (current state)
   - Config.json (parameters)
   - Last N iteration summaries (from JSONL)
   - Compact state summary (Step 2b)
   - Full agent protocol instructions
2. **Write to temp file**: `scratch/.dispatch-prompt-{NNN}.md`
3. **Execute**: `claude -p "$(cat scratch/.dispatch-prompt-{NNN}.md)" --max-turns 50 --output-format json`
4. **Collect output**: Agent writes iteration file directly to disk
5. **Verify**: Orchestrator checks iteration file and JSONL were created
6. **Cleanup**: Remove temp prompt file

### Trade-offs

| Aspect | Task Tool Dispatch | `claude -p` Dispatch |
|--------|-------------------|---------------------|
| Context freshness | Shared budget, may degrade | Guaranteed fresh |
| Token cost | Lower (cached context) | Higher (full context per call) |
| Latency | Lower (in-process) | Higher (new process startup) |
| Context size | Limited by parent budget | Full model context available |
| Error handling | In-process exceptions | Process exit codes |

### When to Use

- Autonomous/unattended research sessions (overnight runs)
- Research past iteration 8+ where context degradation is measurable
- Critical research where reasoning quality must not degrade

**Status**: Reference-only. Track adoption based on need for fully autonomous overnight research sessions.

---

## 6. PHASE: SYNTHESIS

### Purpose
Compile all iteration findings into final research/research.md. The synthesis workflow owns the canonical `research/research.md` output.

### Steps

1. **Read all iteration files**: `research/iterations/iteration-*.md`
2. **Read strategy.md**: Final state of questions, approaches
3. **Compile research/research.md**: Merge findings into 17-section format
   - Deduplicate overlapping findings
   - Organize by section topic
   - Add citations from iteration files
   - Cite `{spec_folder}/resource-map.md` in the References section when `config.resource_map_present == true`
   - Do not synthesize a placeholder reference when `resource-map.md` was absent at init
   - Note unanswered questions in Section 12 (Open Questions)
   - **Include a mandatory "## Eliminated Alternatives" section** as primary research output:
     - Consolidate all `ruledOut` entries from iteration JSONL records
     - Consolidate all `## Dead Ends` sections from iteration files
     - Format as a table: `| Approach | Reason Eliminated | Evidence | Iteration(s) |`
     - This section documents negative knowledge (what was tried and why it failed)
     - Treat as primary research output - not an appendix or afterthought
     - Place after Section 11 (Recommendations) and before Section 12 (Open Questions)
4. **If reopening a completed packet later**: snapshot this file as `research/synthesis-v{generation}.md` before any `completed-continue` flow
5. **Update config status**: Set `status: "complete"` in config.json
6. **Final JSONL entry**: `{"type":"event","event":"synthesis_complete","totalIterations":N,"answeredCount":A,"totalQuestions":Q,"stopReason":"converged"}`

### Progressive vs Final Synthesis
- If `progressiveSynthesis: true` (default): research/research.md was updated each iteration. Final synthesis is a cleanup pass.
- If `progressiveSynthesis: false`: research/research.md is created from scratch during synthesis.

---

## 7. PHASE: SAVE

### Purpose
Preserve research context to memory system.

### Steps

1. **Generate context**: `node .skilled/skills/system-spec-kit/runtime/cli/dist/continuity/generate-context.js {spec_folder}`
2. **No extra indexing step in the live contract**: `generate-context.js` is the supported save boundary for this workflow
3. **Verify**: Confirm memory/*.md file created with proper anchors

---

## 8. STATE TRANSITIONS

```text
[INITIALIZED] --> config + strategy + state created
    |
[ITERATING] --> agent dispatched, executing research
    |
[EVALUATING] --> iteration complete, checking convergence
    |
    |-- newInfoRatio >= threshold --> [ITERATING]
    |-- stuck_count >= stuckThreshold --> [STUCK_RECOVERY]
    |-- converged or max_iterations --> [SYNTHESIZING]

[STUCK_RECOVERY] --> widen focus, try different approach
    |
    |-- recovered (newInfoRatio > 0) --> [ITERATING]
    |-- still stuck --> [SYNTHESIZING] (gaps documented)

[SYNTHESIZING] --> final research/research.md compilation
    |
[SAVING] --> memory context preservation
    |
[COMPLETE] --> all artifacts created, loop finished
```

Hook-capable and non-hook runtimes must follow the same state machine. Hooks may pre-prime context, but they must not change which lifecycle branch the packet selects.

---

## 9. ERROR HANDLING

| Error | Phase | Action |
|-------|-------|--------|
| Agent dispatch timeout | Loop | Retry once with reduced scope. If second timeout, mark iteration as "timeout" and continue |
| WebFetch fails | Loop | Log URL in iteration file, try alternative source, continue with available data |
| State file missing | Init/Loop | If JSONL missing: re-initialize. If strategy missing: reconstruct from JSONL |
| JSONL malformed | Loop | Skip malformed lines, reconstruct from valid entries |
| 3+ consecutive failures | Loop | Halt loop, enter synthesis with partial findings |
| Agent dispatch failure (API overload, timeout) | Loop | Escalate through the documented recovery ladder in order. Direct mode fallback is reference-only unless the runtime explicitly supports it. |
| Memory save fails | Save | Preserve the current `{artifact_dir}` packet as backup, then log the error |

### State Recovery Protocol

When state files are missing or corrupted, apply this 5-priority cascade:

| Priority | Condition | Recovery Action |
|----------|-----------|----------------|
| 1 (Primary) | JSONL exists and parseable | Normal operation (with fault-tolerant parsing) |
| 2 (Strategy rebuild) | JSONL exists, strategy.md missing | Reconstruct strategy from JSONL: extract questions, focus areas, newInfoRatio trend. Create minimal strategy.md |
| 3 (JSONL reconstruction) | JSONL missing/corrupt, iteration files exist | Scan `research/iterations/iteration-*.md`, parse Assessment sections, reconstruct JSONL with `status: "reconstructed"` |
| 4 (Config-only restart) | Only config.json remains | Restart from initialization phase using config parameters. Log: `{"type":"event","event":"fresh_restart","reason":"state_files_missing"}` |
| 5 (Abort) | Config.json also missing | Cannot recover. Report error and halt. |

Each priority level is attempted in order. If a level fails, fall through to the next. See state-format.md for JSONL reconstruction details.

---

## 10. CONFIRM MODE ADDITIONS

In confirm mode, the YAML workflow adds approval gates:

| Gate Location | Behavior |
|---------------|----------|
| After initialization | Show config and initial strategy. Wait for approval |
| After each iteration | Show iteration findings and convergence status. Options: Continue, Adjust Focus, Stop |
| Before synthesis | Show summary of all iterations. Wait for approval to synthesize |
| After synthesis | Show final research/research.md summary. Approve or request revisions |

---

## 11. REVIEW MODE ROUTING

Deep-review lifecycle, convergence, state schemas, traceability protocols, and report contracts live in the sibling `deep-review` skill.

This reference keeps only the routing rule: do not document or execute review-mode loop behavior from `deep-research`. Route review requests to `deep-review/SKILL.md` and its references.


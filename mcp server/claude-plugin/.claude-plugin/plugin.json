{
  "name": "media-editor",
  "version": "1.0.0",
  "description": "Edit, convert and compress images, video and audio in your project folder with a local MCP server that brings its own ffmpeg, plus the Media Editor skill.",
  "author": {
    "name": "Michel Kerkmeester"
  },
  "license": "MIT",
  "keywords": ["media", "image", "video", "audio", "ffmpeg", "hls"],
  "mcpServers": {
    "media-editor": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/dist/index.js",
        "${CLAUDE_PROJECT_DIR}",
        "--output-dir",
        "${CLAUDE_PROJECT_DIR}/media files/export"
      ],
      "env": {
        "MEDIA_EDITOR_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}

{
  "name": "media-editor-mcp",
  "version": "1.1.0",
  "description": "MCP server that edits images, video, and audio.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "media-editor-mcp": "dist/index.js",
    "media-editor": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "tsc -p tsconfig.scripts.json && node build/tools/scripts/build-bundle.js",
    "plugin": "tsc -p tsconfig.scripts.json && node build/tools/scripts/build-plugin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pinned": "tsc -p tsconfig.scripts.json && node build/tools/scripts/test-pinned.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
